{
  "name": "Suar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "start": "node --max-old-space-size=4096 bin/server.js",
    "build": "node ace build",
    "skeletons:build": "boneyard-js build --out ./inertia/bones/generated",
    "skeletons:watch": "boneyard-js build --watch --out ./inertia/bones/generated",
    "build:ignore-ts-errors": "node ace build --ignore-ts-errors",
    "dev": "node --max-old-space-size=4096 ace serve --hmr",
    "dev:with-typecheck": "concurrently \"pnpm run typecheck:watch\" \"pnpm run dev\"",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "svelte-check": "svelte-check --tsconfig ./inertia/tsconfig.json",
    "check:svelte": "svelte-check --tsconfig ./inertia/tsconfig.json",
    "check:svelte:watch": "svelte-check --tsconfig ./inertia/tsconfig.json --watch",
    "check:svelte:strict": "svelte-check --tsconfig ./inertia/tsconfig.json --fail-on-warnings",
    "check:arch:backend:side-effects": "node ./scripts/check_backend_side_effect_boundary.mjs",
    "check:arch:backend:auth-layers": "node ./scripts/check_auth_layer_boundary.mjs",
    "check:arch:backend:module-layers": "node ./scripts/check_module_layer_placement.mjs",
    "check:arch:backend:module-domain-boundary": "node ./scripts/check_module_domain_boundary.mjs",
    "check:arch:backend:port-taxonomy": "node ./scripts/check_backend_port_taxonomy.mjs",
    "check:arch:backend:public-contract-surface": "node ./scripts/check_public_contract_surface.mjs",
    "check:arch:backend:exceptions": "node ./scripts/check_exception_boundaries.mjs",
    "security:secrets": "sh scripts/check_staged_secrets.sh",
    "security:dependencies": "pnpm audit --prod --audit-level=high",
    "security:check": "pnpm run security:secrets && pnpm run security:dependencies",
    "test": "pnpm run test:unit",
    "test:all": "node --import=@poppinss/ts-exec bin/test.ts",
    "db:test:migrate": "sh scripts/db_test_migrate.sh",
    "db:migrations:verify": "node ace migration:ledger-verify",
    "test:integration:safe": "sh scripts/test_integration_safe.sh",
    "test:all:safe": "pnpm run test:unit && pnpm run test:integration:safe",
    "test:full-confidence": "pnpm run test:all:safe && pnpm run test:quality:critical",
    "test:unit": "node --import=@poppinss/ts-exec bin/test.ts unit",
    "test:integration": "node --import=@poppinss/ts-exec bin/test.ts integration",
    "benchmark:search": "node --import=@poppinss/ts-exec scripts/search/run_search_benchmark.ts",
    "test:redis:backup-restore": "sh scripts/test_redis_main_backup_restore.sh",
    "test:redis:authorization": "sh scripts/test_redis_authorization_integration.sh",
    "test:redis:integration": "sh scripts/test_redis_integration.sh",
    "test:redis:generation-capacity": "CACHE_GENERATION_CAPACITY_DRILL=1 CACHE_INTEGRATION_DRIVER=redis node --import=@poppinss/ts-exec bin/test.ts integration --files app/modules/cache/tests/backend/integration/cache_generation_capacity.spec.ts",
    "test:redis:task-list-load": "CACHE_TASK_LIST_LOAD_DRILL=1 CACHE_INTEGRATION_DRIVER=redis node --import=@poppinss/ts-exec bin/test.ts integration --files app/modules/tasks/tests/backend/integration/task_list_cache_load.spec.ts",
    "test:redis:memory-pressure": "sh scripts/test_redis_memory_pressure.sh",
    "test:redis:resilience": "sh scripts/test_cache_redis_resilience.sh",
    "test:e2e": "playwright test",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:watch": "node --import=@poppinss/ts-exec bin/test.ts --watch",
    "debug": "cross-env VITE_DEBUG=true node --max-old-space-size=4096 ace serve --hmr",
    "lint": "concurrently --group --timings \"pnpm run lint:backend:app\" \"pnpm run lint:backend:rest\" \"pnpm run lint:frontend\" \"pnpm run lint:config\"",
    "lint:backend": "concurrently --group \"pnpm run lint:backend:app\" \"pnpm run lint:backend:rest\" \"pnpm run lint:config\"",
    "lint:backend:app": "eslint ./app --cache --cache-location .cache/eslint/app",
    "lint:backend:rest": "eslint ./bin ./start ./config ./types ./tests ./server.ts --cache --cache-location .cache/eslint/rest",
    "lint:config": "eslint --no-ignore ./eslint.config.js ./svelte.config.js ./vite.config.ts ./vitest.config.ts ./playwright.config.ts ./.storybook/main.ts ./.storybook/preview.ts --cache --cache-location .cache/eslint/config",
    "lint:frontend": "concurrently --group \"pnpm run lint:frontend:svelte\" \"pnpm run lint:frontend:ts\"",
    "lint:frontend:svelte": "eslint \"inertia/**/*.svelte\" --cache --cache-location .cache/eslint/frontend-svelte",
    "lint:frontend:ts": "eslint \"inertia/**/*.ts\" --cache --cache-location .cache/eslint/frontend-ts",
    "lint:fix": "concurrently --group \"pnpm exec eslint ./app --cache --cache-location .cache/eslint/app --fix\" \"pnpm exec eslint ./bin ./start ./config ./types ./tests ./server.ts --cache --cache-location .cache/eslint/rest --fix\" \"pnpm exec eslint \\\"inertia/**/*.svelte\\\" --cache --cache-location .cache/eslint/frontend-svelte --fix\" \"pnpm exec eslint \\\"inertia/**/*.ts\\\" --cache --cache-location .cache/eslint/frontend-ts --fix\" \"pnpm exec eslint --no-ignore ./eslint.config.js ./svelte.config.js ./vite.config.ts ./vitest.config.ts ./playwright.config.ts ./.storybook/main.ts ./.storybook/preview.ts --cache --cache-location .cache/eslint/config --fix\"",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./inertia/tsconfig.json",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:contract": "node --import=@poppinss/ts-exec bin/test.ts contract",
    "test:inventory": "node scripts/tests/collect_test_inventory.mjs && node scripts/tests/assert_test_inventory.mjs",
    "test:inventory:modules": "node scripts/tests/collect_module_suite_matrix.mjs && node scripts/tests/assert_module_suite_matrix.mjs",
    "test:ui:runnable": "vitest run --config vitest.config.ts",
    "test:e2e:list": "pnpm exec playwright test --list",
    "test:e2e:policy": "pnpm exec playwright test inertia/apps/user/tests/e2e/meta/no_false_pass_patterns.spec.ts",
    "test:contracts:critical": "node --import=@poppinss/ts-exec bin/test.ts contract --files app/modules/tasks/tests/backend/contract/task_detail.contract.spec.ts && node --import=@poppinss/ts-exec bin/test.ts contract --files app/modules/tasks/tests/backend/contract/task_applications.contract.spec.ts && node --import=@poppinss/ts-exec bin/test.ts contract --files app/modules/reviews/tests/backend/contract/reverse_review.contract.spec.ts",
    "test:e2e:critical": "pnpm exec playwright test inertia/apps/user/tests/e2e/marketplace/apply_withdraw_my_applications.spec.ts inertia/apps/user/tests/e2e/tasks/match_score_explainability.spec.ts inertia/apps/org/tests/e2e/reviews/reverse_sprint_review_dispute_room.spec.ts inertia/apps/org/tests/e2e/projects/staffing_flow.spec.ts",
    "test:quality:critical": "pnpm run test:inventory && pnpm run test:inventory:modules && pnpm run test:e2e:policy && pnpm run test:contracts:critical && pnpm run test:ui:runnable && pnpm run test:e2e:critical"
  },
  "imports": {
    "#commands/*": "./commands/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#composition/*": "./app/composition/*.js",
    "#utils/*": "./app/utils/*.js",
    "#types/*": "./app/types/*.js",
    "#modules/*": "./app/modules/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#platform/*": "./app/infra/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#tests/*": "./tests/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/http-server": "^8.2.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@japa/spec-reporter": "^1.3.3",
    "@playwright/test": "^1.60.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@storybook/addon-a11y": "^10.4.3",
    "@storybook/addon-docs": "^10.4.3",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.4.3",
    "@storybook/svelte-vite": "^10.4.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.6.2",
    "@types/qrcode": "^1.5.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-svelte": "^3.17.1",
    "hot-hook": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "storybook": "^10.4.3",
    "svelte-check": "^4.4.8",
    "svelte-eslint-parser": "^1.6.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@adonisjs/ally": "^6.3.0",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.3.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/i18n": "^3.0.0",
    "@adonisjs/inertia": "^4.2.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lock": "^2.1.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^5.1.1",
    "@adonisjs/transmit": "^3.0.1",
    "@adonisjs/transmit-client": "^1.1.0",
    "@elastic/elasticsearch": "8.15.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@inertiajs/svelte": "^3.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@vinejs/vine": "^4.4.0",
    "axios": "1.18.0",
    "bits-ui": "2.18.1",
    "boneyard-js": "1.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "edge.js": "^6.5.0",
    "lucide-svelte": "^1.0.1",
    "luxon": "^3.7.2",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "svelte": "^5.55.5",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "youch": "^4.1.1",
    "zod": "^4.4.3"
  },
  "hotHook": {
    "boundaries": [
      "./app/modules/**/*.ts",
      "./app/libs/**/*.ts",
      "./app/services/**/*.ts",
      "./app/models/**/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "pnpm": {
    "overrides": {
      "@sveltejs/kit": "2.60.1",
      "brace-expansion": "5.0.8",
      "cookie": "0.7.2",
      "esbuild": "0.28.1",
      "form-data": "4.0.6",
      "qs": "6.15.2"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "core-js",
      "esbuild",
      "protobufjs"
    ],
    "patchedDependencies": {
      "@vinejs/vine@4.4.0": "patches/@vinejs__vine@4.4.0.patch"
    }
  }
}
