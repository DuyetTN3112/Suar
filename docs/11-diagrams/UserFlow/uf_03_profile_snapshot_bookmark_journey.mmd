%% uf_03_profile_snapshot_bookmark_journey.mmd
%% Updated 2026-06-26 (verified).
%% Scope: Profile strengthening, snapshot sharing, and talent bookmark follow-up.
%% Reader intent:
%%   Show how profile improvement, public snapshot sharing, and talent bookmarking connect.
%% Key boundary:
%%   Bookmark means shortlist interest only. It does not create an application, invitation, or assignment by itself.
%% Current caveat:
%%   Org-talent page shell and routes now exist in current runtime, but this journey should still be read through the primary marketplace/profile surfaces first.

flowchart TD
    Start([Start]) --> Profile["Open /profile or /users/:id/profile"]
    Profile --> Improve["Update details and maintain profile skills"]
    Improve --> Snapshot{"Publish shareable snapshot?"}

    Snapshot -->|Yes| Publish["Publish profile snapshot and get current/history state"]
    Publish --> Share["Share /profiles/:slug link"]
    Share --> Viewer["Viewer opens public snapshot"]
    Viewer --> TalentCheck{"Viewer has org sourcing context?"}

    TalentCheck -->|No| End1([End])
    TalentCheck -->|Yes| Bookmark["Save talent bookmark with notes, folder, and rating"]
    Bookmark --> Qualify["Use bookmark as shortlist signal only
no assignment or application created"]
    Qualify --> Workspace["Open /org/bookmarks to refine shortlist"]
    Workspace --> NextAction{"Invite or keep for later?"}
    NextAction -->|Keep| End2([End])
    NextAction -->|Invite later| End3([Follow org/project invitation flow separately])

    Snapshot -->|No| PublicProfile["Keep using standard public profile route"]
    PublicProfile --> End4([End])

    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef process fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333
    class Start,End1,End2,End3,End4 startEnd
    class Profile,Improve,Publish,Share,Viewer,Bookmark,Qualify,Workspace,PublicProfile process
    class Snapshot,TalentCheck,NextAction decision
