%% User Flow 09 — Global search
%% Evidence status: Implemented. Elasticsearch results fall back to bounded SQL sources when unavailable, failed, or empty.
%% Updated: 2026-07-27.
%% Journey actor: authenticated user.

flowchart TB
    subgraph row1[" "]
        direction LR
        Start([Open global search]) --> Query["Enter search terms"] --> Results["See authorized grouped results<br/>with source status and highlights"] --> Found{"Useful result found?"}
        Found -->|No| Refine([Refine query and search again])
        Found -->|Yes| ToResult((A))
    end
    subgraph row2[" "]
        direction LR
        FromSearch((A)) --> Choose["Choose user, talent, task, project,<br/>skill, organization, or task comment"] --> Open["Open permitted destination"] --> End([Search complete])
    end
    ToResult ~~~ FromSearch

    classDef terminal fill:#E8EAF6,stroke:#3F51B5,color:#1E1B4B,stroke-width:2px
    classDef action fill:#E3F2FD,stroke:#2563EB,color:#172554,stroke-width:2px
    classDef decision fill:#FFF7ED,stroke:#EA580C,color:#7C2D12,stroke-width:2px
    class Start,Refine,End terminal
    class Query,Results,Choose,Open action
    class Found decision
    classDef connector fill:#FFFFFF,stroke:#475569,color:#0F172A,stroke-width:2px
    class ToResult,FromSearch connector
    style row1 fill:transparent,stroke:transparent
    style row2 fill:transparent,stroke:transparent
