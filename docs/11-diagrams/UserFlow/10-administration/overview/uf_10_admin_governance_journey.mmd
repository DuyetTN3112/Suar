%% User Flow 10 — System Administration governance
%% Evidence status: Implemented.
%% Updated: 2026-07-28.
%% Journey actor: System Admin principal in the isolated System realm.

flowchart TB
    subgraph enter_governance[" "]
        direction LR
        Start([Authenticate as System Admin principal]) --> Console["Open isolated /admin application"]
        Console --> Domain{"Choose System governance area"}
        Domain -->|AI dispute progress| Board["Open Board 5 · AI dispute progress"]
        Domain -->|Users/access| Inspect["Inspect System user/access state"]
        Domain -->|Audit/platform| Inspect2["Inspect audit or platform state"]
    end

    subgraph inspect_case[" "]
        direction LR
        Board --> Case["Open dispute card room<br/>evidence · comments · AI advice"]
        Inspect --> Decide{"Apply governed action?"}
        Inspect2 --> Decide
        Case --> Decide
        Decide -->|No| EndView([Inspection complete])
        Decide -->|Yes| Confirm["Confirm System operation"]
    end

    subgraph apply_action[" "]
        direction LR
        Result{"Operation authorized?"} -->|No| Denied([Denied; state unchanged])
        Result -->|Yes| Applied["See updated state<br/>and audit evidence"]
        Applied --> End([System action complete])
    end

    Confirm --> Result
    style enter_governance fill:none,stroke:none
    style inspect_case fill:none,stroke:none
    style apply_action fill:none,stroke:none

    classDef terminal fill:#E8EAF6,stroke:#3F51B5,color:#1E1B4B,stroke-width:2px
    classDef action fill:#E3F2FD,stroke:#2563EB,color:#172554,stroke-width:2px
    classDef privileged fill:#FFF7ED,stroke:#EA580C,color:#7C2D12,stroke-width:2px
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333,stroke-width:2px
    class Start,EndView,Denied,End terminal
    class Console,Inspect,Inspect2,Confirm,Applied action
    class Board,Case privileged
    class Domain,Decide,Result decision
