flowchart TB
    Start([Open notification center]) --> Connect["Connect Transmit SSE<br/>realtime invalidation stream"] --> Feed["See paged feed<br/>and unread count"] --> Select{"What does user need?"}
    Select -->|Inspect| Detail["Open notification target"]
    Select -->|Read state| Read["Mark one or all as read"]
    Select -->|Cleanup| Delete["Delete one or all read items"]
    Select -->|Realtime push| Push["Receive Transmit SSE invalidation<br/>auto-update unread count & feed"]
    Select -->|Refresh| Refresh["Refresh latest feed"]
    Detail --> End([Journey continues at target])
    Read --> Current["See current feed and unread count"] --> EndFeed([Notification state current])
    Delete --> Current
    Push --> Current
    Refresh --> Current

