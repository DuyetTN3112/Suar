%% Class Diagram: User & Auth Core
%% Updated 2026-06-26 (verified).
%% Scope: Identity, OAuth binding, remember-me token, and domain entity.

classDiagram
    class User {
        +id
        +username
        +email
        +status
        +system_role
        +current_organization_id
        +auth_method
        +avatar_url
        +bio
        +is_external_contributor
        +profile_settings
        +trust_data
        +credibility_data
        +deleted_at
    }

    class UserOAuthProvider {
        +id
        +user_id
        +provider
        +provider_id
        +email
        +access_token
        +refresh_token
    }

    class RememberMeToken {
        +id
        +tokenable_id
        +hash
        +expires_at
    }

    class UserEntity {
        <<Domain Entity>>
        +id
        +username
        +email
        +status
        +systemRole
        +currentOrganizationId
        +authMethod
        +isExternalContributor
        +deletedAt
        +isActive
        +isAdmin
        +isSuperadmin
        +canChangeRoleOf()
        +canDeactivate()
    }

    class UserRepository {
        <<interface>>
        +findById()
        +findActiveOrFail()
        +findNotDeletedOrFail()
        +findWithOrganizations()
        +isActive()
        +isExternalContributor()
        +isExternalContributor()
        +isSystemAdmin()
    }

    User "1" --> "many" UserOAuthProvider : has OAuth providers
    User "1" --> "many" RememberMeToken : has remember tokens
    User --> UserEntity : mapped to domain
    UserRepository ..> UserEntity : loads

    note for User "OAuth only in current routes.
    is_external_contributor marks external contributor eligibility.
    Remember-me is provided by Adonis session auth."
    note for UserRepository "isExternalContributor is the product-facing capability."
