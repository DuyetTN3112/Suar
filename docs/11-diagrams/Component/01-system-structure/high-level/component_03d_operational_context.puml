@startuml
' UML Component 03d — Operational context
' Evidence status: Implemented source modules and public contracts.
' Updated: 2026-07-27.

!pragma layout elk
left to right direction

skinparam backgroundColor white
skinparam PageMargin 10
skinparam shadowing false
skinparam componentStyle uml2
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam component {
  BackgroundColor #F0FDF4
  BorderColor #16A34A
  FontColor #14532D
}

component "HTTP\nprovides HttpExecutionContext" as Http
component "Business modules" as Business
component "Observability\nprovides PlatformObservability" as Observability
component "Logger + Errors\nLoggerService + ApplicationException" as Logging

Http ..> Observability : request trace context
Http ..> Logging : request failures
Business ..> Observability : structured events
Business ..> Logging : diagnostics

@enduml
