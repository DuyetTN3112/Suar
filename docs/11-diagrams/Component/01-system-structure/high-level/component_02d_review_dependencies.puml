@startuml
' UML Component 02d — Review dependencies
' Evidence status: Implemented source modules and public contracts.
' Updated: 2026-07-27.

!pragma layout elk
left to right direction

skinparam backgroundColor white
skinparam PageMargin 10
skinparam shadowing false
skinparam componentStyle uml2
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #172554
}

component "Reviews\nquorum · confirmation · dispute" as Reviews
component "Tasks\nassignment + submission facts" as Tasks
component "Users\nreviewer/reviewee identity" as Users
component "Skills\nrubric + proficiency" as Skills
component "Authorization\nreview governance" as Authorization

Reviews ..> Tasks : TaskPublicApi
Reviews ..> Users : UserPublicApi
Reviews ..> Skills : ProficiencyFramework
Reviews ..> Authorization : PolicyEnforcer

@enduml
