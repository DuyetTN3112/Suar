@startuml
' UML Component 02c — Marketplace dependencies
' Evidence status: Implemented source modules and public contracts.
' Updated: 2026-07-26.

!pragma layout elk
left to right direction

skinparam backgroundColor white
skinparam PageMargin 10
skinparam shadowing false
skinparam componentStyle uml2
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #172554
}

component "Marketplace\ncandidate discovery + proposals" as Marketplace
component "Marketplace-owned\nTaskApplicationFlowPort" as MarketplacePort
component "Outer composition\nTasks→Marketplace adapter" as Composition
component "Tasks\nTaskApplicationCapability" as Tasks
component "Projects\nproject access" as Projects
component "Authorization\nproposal processing policy" as Authorization

Marketplace ..> MarketplacePort : application actions
Composition ..> MarketplacePort : implements + injects
Composition ..> Tasks : consumes pure capability
Marketplace ..> Projects : ProjectPublicApi
Marketplace ..> Authorization : PermissionChecker

@enduml
