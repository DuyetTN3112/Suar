@startuml
' UML Component 02 — Core capability dependencies
' Evidence status: Implemented source modules and public contracts.
' Updated: 2026-07-27.
' Scope: business-capability ownership and material static dependencies.

!pragma layout elk
top to bottom direction

skinparam backgroundColor white
skinparam PageMargin 10
skinparam shadowing false
skinparam componentStyle uml2
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam ArrowColor #475569
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #172554
}
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
}

rectangle "Suar application process\n<<modular monolith>>" {
  component "Identity & governance\nusers · auth · authorization\norganizations" as Foundation
  component "Project delivery\nprojects · sprints · tasks" as Delivery
  component "Marketplace\ncandidate discovery + proposals" as Marketplace
  component "Review & capability\nreviews · skills" as Review

  Delivery ..> Foundation : actor + access context
  Marketplace ..> Delivery : public tasks + proposals
  Marketplace ..> Foundation : candidate authorization
  Review ..> Delivery : submission + assignment facts
  Review ..> Foundation : review actors + policy
}

@enduml
