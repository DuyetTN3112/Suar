@startuml
' UML Component 04a — Consumer-owned port
' Evidence status: Implemented preferred seam.
' Updated: 2026-07-29.

!pragma layout elk
top to bottom direction

skinparam backgroundColor white
skinparam PageMargin 10
skinparam shadowing false
skinparam componentStyle uml2
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #172554
}
component "Projects application" as Projects
component "Assignment invariant\n<<consumer port>>" as Port #FEF3C7
component "ProjectTaskAssignmentInvariantAdapter\n<<outer composition adapter>>" as Adapter
component "Tasks assignment query/repository capability" as Tasks

Projects ..> Port : requires
Adapter - Port : implements
Adapter ..> Tasks : calls

@enduml
