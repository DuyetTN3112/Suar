<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_MarketplaceProposalAssignment"
  targetNamespace="https://suar.example/docs/bpmn">
  <bpmn:message id="Message_Proposal" name="Marketplace proposal" />
  <bpmn:message id="Message_ReviewRequest" name="Pending proposal review request" />
  <bpmn:message id="Message_Decision" name="Approve or reject decision" />
  <bpmn:message id="Message_Result" name="Proposal result" />

  <bpmn:collaboration id="Collaboration_MarketplaceProposalAssignment">
    <bpmn:documentation>Evidence status: Implemented. Updated: 2026-07-27. Scope: marketplace proposal submission through authorized review and assignment result. Descriptive collaboration only; not an executable process definition.</bpmn:documentation>
    <bpmn:participant id="Participant_Contributor" name="Contributor" processRef="Process_Contributor" />
    <bpmn:participant id="Participant_Platform" name="Suar Platform" processRef="Process_Platform" />
    <bpmn:participant id="Participant_Reviewer" name="Authorized Reviewer" processRef="Process_Reviewer" />
    <bpmn:messageFlow id="MessageFlow_SubmitProposal" name="Proposal" sourceRef="Task_SubmitProposal" targetRef="StartEvent_ProposalReceived" />
    <bpmn:messageFlow id="MessageFlow_RequestReview" sourceRef="Task_RequestReview" targetRef="StartEvent_ReviewRequested" />
    <bpmn:messageFlow id="MessageFlow_SendDecision" name="Decision" sourceRef="Task_SendDecision" targetRef="Event_DecisionReceived" />
    <bpmn:messageFlow id="MessageFlow_SendResult" name="Result notification" sourceRef="Task_SendResult" targetRef="Event_ResultReceived" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Contributor" name="Submit marketplace proposal" isExecutable="false">
    <bpmn:documentation>Contributor-facing process. The platform remains authoritative for eligibility and the final outcome.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_Contributor" name="Needs a public task">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_SubmitProposal" name="Prepare and submit proposal" messageRef="Message_Proposal">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ResultReceived" name="Result received">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Result" messageRef="Message_Result" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_Contributor" name="Outcome known">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_Contributor" targetRef="Task_SubmitProposal" />
    <bpmn:sequenceFlow id="Flow_C2" name="Wait for processing result" sourceRef="Task_SubmitProposal" targetRef="Event_ResultReceived" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Event_ResultReceived" targetRef="EndEvent_Contributor" />
  </bpmn:process>

  <bpmn:process id="Process_Platform" name="Validate and process proposal" isExecutable="false">
    <bpmn:documentation>Current runtime creates a pending task_application only after policy checks. Approval assigns only while the task remains unassigned; rejection and stale outcomes retain a reason. All outcomes are audited and notified.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_ProposalReceived" name="Proposal received">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Proposal" messageRef="Message_Proposal" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateProposal" name="Validate proposal policy">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Eligible?">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3_Eligible</bpmn:outgoing>
      <bpmn:outgoing>Flow_P3_Ineligible</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestReview" name="Create pending application and request review" messageRef="Message_ReviewRequest">
      <bpmn:incoming>Flow_P3_Eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_DecisionReceived" name="Decision received">
      <bpmn:incoming>Flow_P4</bpmn:incoming>
      <bpmn:outgoing>Flow_P5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Decision" messageRef="Message_Decision" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approve?">
      <bpmn:incoming>Flow_P5</bpmn:incoming>
      <bpmn:outgoing>Flow_P6_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_P6_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Unassigned" name="Task still unassigned?">
      <bpmn:incoming>Flow_P6_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_P7_Unassigned</bpmn:outgoing>
      <bpmn:outgoing>Flow_P7_Stale</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AssignContributor" name="Approve, assign and reject other pending proposals">
      <bpmn:incoming>Flow_P7_Unassigned</bpmn:incoming>
      <bpmn:outgoing>Flow_P8_Assigned</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StaleApproval" name="Reject stale approval">
      <bpmn:incoming>Flow_P7_Stale</bpmn:incoming>
      <bpmn:outgoing>Flow_P8_Stale</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RecordRejection" name="Reject proposal with reason">
      <bpmn:incoming>Flow_P6_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_P8_Rejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PolicyRejection" name="Record policy rejection">
      <bpmn:incoming>Flow_P3_Ineligible</bpmn:incoming>
      <bpmn:outgoing>Flow_P8_Policy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_OutcomeMerge">
      <bpmn:incoming>Flow_P8_Assigned</bpmn:incoming>
      <bpmn:incoming>Flow_P8_Stale</bpmn:incoming>
      <bpmn:incoming>Flow_P8_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_P8_Policy</bpmn:incoming>
      <bpmn:outgoing>Flow_P9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendResult" name="Audit and notify contributor" messageRef="Message_Result">
      <bpmn:incoming>Flow_P9</bpmn:incoming>
      <bpmn:outgoing>Flow_P10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Platform" name="State current">
      <bpmn:incoming>Flow_P10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_P1" sourceRef="StartEvent_ProposalReceived" targetRef="Task_ValidateProposal" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_ValidateProposal" targetRef="Gateway_Eligible" />
    <bpmn:sequenceFlow id="Flow_P3_Eligible" name="Yes" sourceRef="Gateway_Eligible" targetRef="Task_RequestReview" />
    <bpmn:sequenceFlow id="Flow_P3_Ineligible" name="No" sourceRef="Gateway_Eligible" targetRef="Task_PolicyRejection" />
    <bpmn:sequenceFlow id="Flow_P4" name="Wait for reviewer" sourceRef="Task_RequestReview" targetRef="Event_DecisionReceived" />
    <bpmn:sequenceFlow id="Flow_P5" sourceRef="Event_DecisionReceived" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_P6_Approve" name="Approve" sourceRef="Gateway_Approved" targetRef="Gateway_Unassigned" />
    <bpmn:sequenceFlow id="Flow_P6_Reject" name="Reject" sourceRef="Gateway_Approved" targetRef="Task_RecordRejection" />
    <bpmn:sequenceFlow id="Flow_P7_Unassigned" name="Yes" sourceRef="Gateway_Unassigned" targetRef="Task_AssignContributor" />
    <bpmn:sequenceFlow id="Flow_P7_Stale" name="No" sourceRef="Gateway_Unassigned" targetRef="Task_StaleApproval" />
    <bpmn:sequenceFlow id="Flow_P8_Assigned" sourceRef="Task_AssignContributor" targetRef="Gateway_OutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_P8_Stale" sourceRef="Task_StaleApproval" targetRef="Gateway_OutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_P8_Rejected" sourceRef="Task_RecordRejection" targetRef="Gateway_OutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_P8_Policy" sourceRef="Task_PolicyRejection" targetRef="Gateway_OutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_P9" sourceRef="Gateway_OutcomeMerge" targetRef="Task_SendResult" />
    <bpmn:sequenceFlow id="Flow_P10" sourceRef="Task_SendResult" targetRef="EndEvent_Platform" />
  </bpmn:process>

  <bpmn:process id="Process_Reviewer" name="Review pending proposal" isExecutable="false">
    <bpmn:documentation>An authorized reviewer evaluates one pending proposal and sends an approve/reject decision. Detailed authorization remains in Activity and Sequence diagrams.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_ReviewRequested" name="Review requested">
      <bpmn:outgoing>Flow_R1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ReviewRequest" messageRef="Message_ReviewRequest" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ReviewProposal" name="Review proposal and choose decision">
      <bpmn:incoming>Flow_R1</bpmn:incoming>
      <bpmn:outgoing>Flow_R2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendDecision" name="Send decision" messageRef="Message_Decision">
      <bpmn:incoming>Flow_R2</bpmn:incoming>
      <bpmn:outgoing>Flow_R3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Reviewer" name="Decision submitted">
      <bpmn:incoming>Flow_R3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_R1" sourceRef="StartEvent_ReviewRequested" targetRef="Task_ReviewProposal" />
    <bpmn:sequenceFlow id="Flow_R2" sourceRef="Task_ReviewProposal" targetRef="Task_SendDecision" />
    <bpmn:sequenceFlow id="Flow_R3" sourceRef="Task_SendDecision" targetRef="EndEvent_Reviewer" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_MarketplaceProposalAssignment">
    <bpmndi:BPMNPlane id="BPMNPlane_MarketplaceProposalAssignment" bpmnElement="Collaboration_MarketplaceProposalAssignment">
      <bpmndi:BPMNShape id="Shape_Participant_Contributor" bpmnElement="Participant_Contributor" isHorizontal="true">
        <dc:Bounds x="40" y="50" width="1560" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_Platform" bpmnElement="Participant_Platform" isHorizontal="true">
        <dc:Bounds x="40" y="250" width="1560" height="330" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_Reviewer" bpmnElement="Participant_Reviewer" isHorizontal="true">
        <dc:Bounds x="40" y="600" width="1560" height="180" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartEvent_Contributor" bpmnElement="StartEvent_Contributor">
        <dc:Bounds x="100" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SubmitProposal" bpmnElement="Task_SubmitProposal">
        <dc:Bounds x="180" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_ResultReceived" bpmnElement="Event_ResultReceived">
        <dc:Bounds x="1370" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Contributor" bpmnElement="EndEvent_Contributor">
        <dc:Bounds x="1480" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartEvent_ProposalReceived" bpmnElement="StartEvent_ProposalReceived">
        <dc:Bounds x="240" y="292" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ValidateProposal" bpmnElement="Task_ValidateProposal">
        <dc:Bounds x="310" y="270" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Eligible" bpmnElement="Gateway_Eligible" isMarkerVisible="true">
        <dc:Bounds x="480" y="285" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RequestReview" bpmnElement="Task_RequestReview">
        <dc:Bounds x="570" y="270" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_DecisionReceived" bpmnElement="Event_DecisionReceived">
        <dc:Bounds x="780" y="292" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Approved" bpmnElement="Gateway_Approved" isMarkerVisible="true">
        <dc:Bounds x="850" y="285" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Unassigned" bpmnElement="Gateway_Unassigned" isMarkerVisible="true">
        <dc:Bounds x="950" y="285" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AssignContributor" bpmnElement="Task_AssignContributor">
        <dc:Bounds x="1040" y="270" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_StaleApproval" bpmnElement="Task_StaleApproval">
        <dc:Bounds x="1040" y="385" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RecordRejection" bpmnElement="Task_RecordRejection">
        <dc:Bounds x="850" y="480" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PolicyRejection" bpmnElement="Task_PolicyRejection">
        <dc:Bounds x="310" y="460" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_OutcomeMerge" bpmnElement="Gateway_OutcomeMerge" isMarkerVisible="true">
        <dc:Bounds x="1220" y="365" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SendResult" bpmnElement="Task_SendResult">
        <dc:Bounds x="1310" y="350" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Platform" bpmnElement="EndEvent_Platform">
        <dc:Bounds x="1500" y="372" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartEvent_ReviewRequested" bpmnElement="StartEvent_ReviewRequested">
        <dc:Bounds x="632" y="672" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviewProposal" bpmnElement="Task_ReviewProposal">
        <dc:Bounds x="710" y="650" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SendDecision" bpmnElement="Task_SendDecision">
        <dc:Bounds x="940" y="650" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Reviewer" bpmnElement="EndEvent_Reviewer">
        <dc:Bounds x="1130" y="672" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_C1" bpmnElement="Flow_C1">
        <di:waypoint x="136" y="140" />
        <di:waypoint x="180" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_C2" bpmnElement="Flow_C2">
        <di:waypoint x="340" y="140" />
        <di:waypoint x="1370" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_C3" bpmnElement="Flow_C3">
        <di:waypoint x="1406" y="140" />
        <di:waypoint x="1480" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_P1" bpmnElement="Flow_P1">
        <di:waypoint x="276" y="310" />
        <di:waypoint x="310" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P2" bpmnElement="Flow_P2">
        <di:waypoint x="440" y="310" />
        <di:waypoint x="480" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P3_Eligible" bpmnElement="Flow_P3_Eligible">
        <di:waypoint x="530" y="310" />
        <di:waypoint x="570" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P3_Ineligible" bpmnElement="Flow_P3_Ineligible">
        <di:waypoint x="505" y="335" />
        <di:waypoint x="505" y="500" />
        <di:waypoint x="470" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P4" bpmnElement="Flow_P4">
        <di:waypoint x="730" y="310" />
        <di:waypoint x="780" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P5" bpmnElement="Flow_P5">
        <di:waypoint x="816" y="310" />
        <di:waypoint x="850" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P6_Approve" bpmnElement="Flow_P6_Approve">
        <di:waypoint x="900" y="310" />
        <di:waypoint x="950" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P6_Reject" bpmnElement="Flow_P6_Reject">
        <di:waypoint x="875" y="335" />
        <di:waypoint x="875" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P7_Unassigned" bpmnElement="Flow_P7_Unassigned">
        <di:waypoint x="1000" y="310" />
        <di:waypoint x="1040" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P7_Stale" bpmnElement="Flow_P7_Stale">
        <di:waypoint x="975" y="335" />
        <di:waypoint x="975" y="425" />
        <di:waypoint x="1040" y="425" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P8_Assigned" bpmnElement="Flow_P8_Assigned">
        <di:waypoint x="1190" y="310" />
        <di:waypoint x="1245" y="310" />
        <di:waypoint x="1245" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P8_Stale" bpmnElement="Flow_P8_Stale">
        <di:waypoint x="1190" y="425" />
        <di:waypoint x="1245" y="425" />
        <di:waypoint x="1245" y="415" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P8_Rejected" bpmnElement="Flow_P8_Rejected">
        <di:waypoint x="1000" y="520" />
        <di:waypoint x="1245" y="520" />
        <di:waypoint x="1245" y="415" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P8_Policy" bpmnElement="Flow_P8_Policy">
        <di:waypoint x="470" y="500" />
        <di:waypoint x="1220" y="500" />
        <di:waypoint x="1220" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P9" bpmnElement="Flow_P9">
        <di:waypoint x="1270" y="390" />
        <di:waypoint x="1310" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P10" bpmnElement="Flow_P10">
        <di:waypoint x="1450" y="390" />
        <di:waypoint x="1500" y="390" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_R1" bpmnElement="Flow_R1">
        <di:waypoint x="668" y="690" />
        <di:waypoint x="710" y="690" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_R2" bpmnElement="Flow_R2">
        <di:waypoint x="890" y="690" />
        <di:waypoint x="940" y="690" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_R3" bpmnElement="Flow_R3">
        <di:waypoint x="1080" y="690" />
        <di:waypoint x="1130" y="690" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_MessageFlow_SubmitProposal" bpmnElement="MessageFlow_SubmitProposal">
        <di:waypoint x="260" y="180" />
        <di:waypoint x="258" y="292" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MessageFlow_RequestReview" bpmnElement="MessageFlow_RequestReview">
        <di:waypoint x="650" y="350" />
        <di:waypoint x="650" y="672" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MessageFlow_SendDecision" bpmnElement="MessageFlow_SendDecision">
        <di:waypoint x="1010" y="650" />
        <di:waypoint x="1010" y="590" />
        <di:waypoint x="798" y="590" />
        <di:waypoint x="798" y="328" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MessageFlow_SendResult" bpmnElement="MessageFlow_SendResult">
        <di:waypoint x="1380" y="350" />
        <di:waypoint x="1388" y="158" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
