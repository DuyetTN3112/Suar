flowchart LR
    subgraph Users["app/modules/users"]
        direction TB
        UserEntry["controllers/listeners"]
        UserActions["actions/commands + queries<br/>profile · snapshot · history · talent"]
        UserPorts["actions/ports/outbound<br/>profile evidence/fact readers"]
        UserDomain["domain<br/>profile aggregate + metric rules"]
        UserInfra["infra<br/>snapshot · work-history · performance repositories"]

        UserEntry -->|"one intent"| UserActions
        UserActions --> UserDomain
        UserActions --> UserPorts
        UserPorts --> UserInfra
    end

    subgraph Skills["app/modules/skills"]
        direction TB
        SkillEntry["controllers"]
        SkillActions["actions/commands + queries<br/>catalog · proficiency · rubric"]
        SkillPorts["actions/ports/outbound"]
        SkillDomain["domain<br/>catalog/rubric policies"]
        SkillInfra["infra<br/>models · repositories · adapters"]

        SkillEntry -->|"one intent"| SkillActions
        SkillActions --> SkillDomain
        SkillActions --> SkillPorts
        SkillPorts --> SkillInfra
    end

    Composition["Outer composition<br/>consumer ports → provider facts"]
    Evidence["Tasks + Reviews<br/>versioned evidence facts"]
    ProjectSearch["Projects + Search<br/>stable capabilities"]
    PostgreSQL[("PostgreSQL")]

    UserPorts --> Composition
    SkillPorts --> Composition
    Composition --> Evidence
    Composition --> ProjectSearch
    UserInfra --> PostgreSQL
    SkillInfra --> PostgreSQL

