flowchart TB
    subgraph row1["Event dispatch"]
        direction LR
        Constants["Module-local constants<br/>shared event vocabulary"] -.->|"type and name contracts"| Events["Module event packages<br/>domain and application events"] --> Bus["In-process event bus"] --> Listeners["Listener packages<br/>notification · cache · review · audit · search"] --> ToSinks((A))
    end

    subgraph row2["Listener dependencies"]
        direction LR
        FromListeners((A)) -->|"invoke bounded APIs"| Contracts["Module public contracts<br/>notification · audit · search · business modules"] -->|"use adapters"| Stores["Operational stores<br/>PostgreSQL · Redis · Elasticsearch"]
        FromListeners -->|"realtime invalidation push"| RealtimeGateway["Transmit SSE Gateway<br/>start/transmit.ts · Redis PubSub"]
        FromListeners -->|"structured diagnostics & exception boundaries"| Logger["Redacted runtime logger<br/>Domain/App/Infra Exception Handlers"]
    end

    ToSinks ~~~ FromListeners

