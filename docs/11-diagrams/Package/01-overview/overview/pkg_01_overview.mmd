flowchart TB
    External["External frameworks/providers<br/>AdonisJS · Lucid · Svelte/Inertia · OAuth"]
    Presentation["Inbound delivery<br/>routes · middleware · controllers · listeners · Ace"]
    Application["Application layer = actions<br/>Commands · Queries · DTOs · inbound/outbound ports"]
    Domain["Domain<br/>entities · policies · invariants · formulas"]
    Composition["Outer composition<br/>synchronous construction + port binding"]
    Infrastructure["Infrastructure<br/>repositories · adapters · projection stores"]
    Data[("PostgreSQL · Redis · Elasticsearch")]
    Runtime["Cross-cutting runtime<br/>events · notifications · Audit · telemetry"]

    External --> Presentation
    Presentation -->|"one intent"| Application
    Application --> Domain
    Application -->|"outbound capability"| Infrastructure
    Composition -.->|"construct + inject"| Application
    Composition -.->|"bind"| Infrastructure
    Infrastructure --> Data
    Application --> Runtime
    Runtime --> Infrastructure

