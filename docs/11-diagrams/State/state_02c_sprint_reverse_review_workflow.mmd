%% Updated 2026-07-19.
%% Ref: app/modules/reviews/domain/sprint_reverse_review_workflow.ts
%% Ref: app/modules/reviews/actions/commands/*sprint_reverse_review_workflow_command.ts
%% Note: sprint reverse review replaces task-level reverse review creation.

stateDiagram-v2
    [*] --> awaiting_review : Sprint enters review_open\nworkflow created

    awaiting_review --> awaiting_response : Reviewer submits rating/comment
    awaiting_review --> in_review : Reserved lane\nfuture multi-review reverse rules

    in_review --> awaiting_response : Reverse review ready for response

    awaiting_response --> done : Reviewer or responder accepts
    awaiting_response --> disputed : Reviewer or responder responds

    disputed --> done : Either side accepts disputed outcome
    disputed --> reported : Either side reports to admin

    reported --> ai_reviewing : System/admin starts\nAI advisory evaluation
    ai_reviewing --> reported : AI callback returns\nadvisory result
    reported --> resolved : System admin resolves
    ai_reviewing --> resolved : System admin resolves\nduring AI review
    resolved --> done : Resolution applied\nor follow-up accepted
    reported --> done : Legacy/manual closure
    done --> [*]

    note right of awaiting_review
        target_type = assigner or environment.
        Assigner cards group sprint task evidence by target person.
        Current environment card stores organization target.
        Sprint package rows can still record project and organization reviews.
    end note

    note right of awaiting_response
        Current submit path is single-review:
        awaiting_review -> awaiting_response.
        in_review exists for lane consistency.
    end note

    note right of done
        Submitted records remain in sprint_manager_reviews
        or sprint_environment_reviews.
        Workflow row stores board/response state.
    end note
