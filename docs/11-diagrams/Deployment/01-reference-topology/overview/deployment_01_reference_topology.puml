      artifact "Fan-out process\nnotification:fanout-work\nshared Suar image" as FanoutArtifact
    }

    node "notification-outbox-worker container\n<<executionEnvironment>>" as OutboxNode {
      artifact "Outbox process\nnotification:outbox-work\nshared Suar image" as OutboxArtifact
    }

    node "postgres container\n<<executionEnvironment>>" as PgNode {
      artifact "PostgreSQL 16" as PgArtifact
