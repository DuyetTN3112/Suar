    node "redis container\n<<executionEnvironment>>" as RedisNode {
      artifact "Redis" as RedisArtifact
    }

    database "postgres_data\n<<Docker volume>>" as PgVolume
    database "redis_data\n<<Docker volume>>" as RedisVolume
