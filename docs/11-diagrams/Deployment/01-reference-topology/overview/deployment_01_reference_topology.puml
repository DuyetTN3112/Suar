cloud "Elasticsearch dev :9200\n<<development service>>" as ElasticDev
cloud "Elasticsearch test :9201\n<<disposable tmpfs test plane>>" as ElasticTest
cloud "Clawagent dispute API\n<<partial external service>>" as Clawagent

