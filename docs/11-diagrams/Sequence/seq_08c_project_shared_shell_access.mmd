%% seq_08c_project_shared_shell_access.mmd — Project Detail Shared Shell Access
%% Updated 2026-06-26.
%% Purpose: How user and org contexts share the project detail shell
%% Reader intent: Show how one project detail surface is resolved from both user-workspace and org-workspace entry points.
%% Key boundary: Shared-shell access only; project CRUD and membership growth sit outside this sequence.
%% Current caveat: Layout/context differs by shell even when the underlying project detail query is shared.
%% Runtime caveat: Current org path is /org/projects/:projectId, not slug-based org routing.
%% Excludes: Project CRUD (see seq_08), project creation (see seq_08a), project delete (see seq_08b)
%% Related: get_project_detail_query.ts, show_project_controller.ts, organization_resolver_middleware.ts

sequenceDiagram
    participant User as Authenticated User
    participant Router as Route Handler
    participant OrgMW as Org Resolver Middleware
    participant Query as GetProjectDetailQuery
    participant Perms as Permission Checker
    participant Page as Svelte Page

    %% ── FROM USER WORKSPACE ──
    rect rgb(232, 245, 233)
        Note over User, Page: Path A: User workspace → /projects/:id

        User->>Router: GET /projects/:id
        Router->>Query: execute(projectId, userId)
        Query->>Perms: checkProjectMembership(userId, projectId)
        Perms-->>Query: {isMember, role}

        alt Has access
            Query-->>Page: {project, members, tasks, role, canEdit, canDelete}
            Page-->>User: Project detail render
        else No access
            Page-->>User: 403 Forbidden
        end
    end

    %% ── FROM ORG WORKSPACE ──
    rect rgb(227, 242, 253)
        Note over User, Page: Path B: Org workspace → /org/projects/:projectId

        User->>Router: GET /org/projects/:projectId
        Router->>OrgMW: resolve org context
        OrgMW-->>Router: {organization, membership}

        Router->>Query: execute(projectId, userId)
        Query->>Perms: checkProjectMembership + orgRole
        Perms-->>Query: {isMember, role, orgRole}

        alt Has access
            Query-->>Page: {project, members, tasks, role, orgRole, orgContext}
            Note right of Page: Shell shows org nav bar
            Page-->>User: Project detail (org-scoped)
        else No access
            Page-->>User: Redirect to org dashboard
        end
    end

    %% ── SHARED SHELL ──
    Note over Page: Shared shell behavior:
    Note over Page: • Same project data from GetProjectDetailQuery
    Note over Page: • Different nav context (user vs org)
    Note over Page: • Org path adds org breadcrumb and org sidebar
    Note over Page: • Permission checks differ by entry path
