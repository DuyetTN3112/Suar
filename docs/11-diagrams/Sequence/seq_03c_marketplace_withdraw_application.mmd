%% seq_03c_marketplace_withdraw_application.mmd
%% Updated 2026-06-26 (verified).
%% Reader intent: Understand what happens when a contributor retracts a pending marketplace proposal.
%% Key boundary: Withdraw-only path; re-proposal rules and organizer-side handling are out of scope.
%% Current caveat: Withdrawal changes both proposal state and task-side proposal counts, even though the UI may present it as one click.
%% Storage caveat: Phase 1 updates task_applications. marketplace_applications is parked for a later storage migration.

sequenceDiagram
    autonumber
    actor FL as External Contributor
    participant B as Browser
    participant C as WithdrawMarketplaceApplicationController
    participant Cmd as WithdrawMarketplaceApplicationCommand
    participant Repo as TaskRepository
    participant DB as PostgreSQL

    FL->>B: Click withdraw
    B->>C: POST /applications/:id/withdraw
    C->>Cmd: execute(dto)
    Cmd->>Repo: load proposal
    Repo->>DB: SELECT task_application
    DB-->>Repo: Result
    Cmd->>Repo: update proposal withdrawn
    Repo->>DB: UPDATE task_applications (runtime truth)
    Cmd->>Repo: decrement external_applications_count
    Repo->>DB: UPDATE tasks
    C-->>B: Redirect
    B-->>FL: Proposal withdrawn
