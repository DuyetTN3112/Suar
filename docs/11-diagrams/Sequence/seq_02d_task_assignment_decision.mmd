%% seq_02d_task_assignment_decision.mmd — Assignment Side Effects Sequence
%% Updated 2026-06-26.
%% Purpose: Time-order flow showing assignment side effects and cross-module calls
%% Reader intent: Show time-order side effects of an assignment decision across rules, repositories, cache, and audit.
%% Key boundary: Decision path only; full status transitions, marketplace discovery, and review execution live elsewhere.
%% Current caveat: Assignment policy depends on org/member visibility and may be triggered from more than one higher-level flow.
%% Excludes: Status transitions, marketplace browse, review flow
%% Related: assign_task_command.ts, process_application_command.ts, revoke_task_access_command.ts

sequenceDiagram
    participant Requester as Creator or Manager
    participant Cmd as AssignTaskCommand
    participant Rules as task_assignment_rules
    participant TaskRepo as TaskRepository
    participant AssignRepo as TaskAssignmentRepository
    participant Cache as cacheStore
    participant Audit as auditPublicApi
    participant Emitter as Event Bus

    Requester->>Cmd: execute(dto)

    %% ── FETCH ──
    Cmd->>TaskRepo: findById(taskId)
    TaskRepo-->>Cmd: task

    %% ── DECIDE ──
    Cmd->>Rules: validateAssignee({isOrgMember, externalContributorEligible, taskVisibility})
    Rules-->>Cmd: PolicyResult

    alt Policy DENIED
        Cmd-->>Requester: PolicyViolationException
    end

    %% ── PERSIST ──
    Cmd->>AssignRepo: create({task_id, assignee_id, assignment_type, status: active})
    AssignRepo-->>Cmd: assignment

    Cmd->>TaskRepo: update(taskId, {assigned_to: assigneeId})

    %% ── SIDE EFFECTS ──
    Cmd->>Audit: write({action: 'assign_task', ...})
    Cmd->>Cache: deleteByPattern('task:*')
    Cmd->>Emitter: emit('task:assigned', {taskId, assigneeId})

    Cmd-->>Requester: assignment record

    %% ── PROCESS APPLICATION PATH ──
    Note over Requester, Emitter: Alternative: ProcessMarketplaceApplicationCommand path

    Requester->>Cmd: processApplication({action: approve})

    Cmd->>Rules: canProcessApplication({actorId, taskCreatorId, isProjectOwnerOrManager})
    Rules-->>Cmd: PolicyResult

    alt Approve
        Cmd->>AssignRepo: create(assignment)
        Cmd->>TaskRepo: update(assigned_to)
        Cmd->>AssignRepo: rejectOtherPendingByTask(taskId, approvedAppId)
        Cmd->>Audit: write(process_application)
        Cmd->>Emitter: emit('task:application:reviewed')
    else Reject
        Cmd->>AssignRepo: updateStatus(rejected)
        Cmd->>Audit: write(process_application)
    end
