%% seq_03_marketplace_apply.mmd
%% Updated 2026-06-26.
%% Purpose: Send proposal for marketplace task — sequence flow
%% Reader intent: Understand how a contributor passes through eligibility checks and enters the marketplace proposal pipeline.
%% Key boundary: Covers proposal submission only; browse, organizer decision, withdraw, and permission nuance live in sibling diagrams.
%% Current caveat: Runtime checks include multiple blockers, so failed proposal attempts often stop before any task-application row is created.
%% Storage caveat: Phase 1 writes task_applications. marketplace_applications is parked for a later storage migration.
%% Excludes: Browse (seq_03a), review proposal (seq_03b), withdraw (seq_03c), permissions (seq_03d)
%% Related: act_02b_marketplace_apply.mmd

sequenceDiagram
    autonumber
    actor User as Contributor
    participant C as ApplyMarketplaceTaskController
    participant Cmd as ApplyMarketplaceTaskCommand
    participant Policy as canApplyForTask
    participant TaskRepo as TaskRepository
    participant AppRepo as TaskApplicationRepository (phase-1 storage)
    participant DB as PostgreSQL
    participant Audit as auditPublicApi
    participant Cache as cacheStore
    participant Evt as Event Emitter

    User->>C: POST /api/v1/tasks/:taskId/apply { message?, portfolio_links? }
    C->>Cmd: execute(dto)

    %% ── FETCH ──
    Cmd->>TaskRepo: findActiveOrFail(task_id)
    TaskRepo->>DB: SELECT active task
    DB-->>TaskRepo: Task

    Cmd->>AppRepo: findExistingByTaskAndApplicant(task_id, user_id)
    AppRepo->>DB: SELECT existing active proposal
    DB-->>AppRepo: Proposal row or null

    %% ── DECIDE (pure policy) ──
    Cmd->>Policy: canApplyForTask({actorId, taskCreatorId, taskVisibility, isTaskAlreadyAssigned, isApplicationDeadlinePassed, hasExistingApplication})

    alt Policy DENIED
        Note right of Policy: Reasons: own task, internal-only, already assigned, deadline passed, duplicate
        Cmd-->>C: PolicyViolationException
        C-->>User: 403/409 with denial reason
    else Policy ALLOWED
        %% ── PERSIST ──
        Cmd->>AppRepo: create({task_id, applicant_id, status: pending, cover_letter, portfolio_links})
        AppRepo->>DB: INSERT task_applications (runtime truth)
        Cmd->>TaskRepo: incrementApplicationsCount(task_id)

        %% ── SIDE EFFECTS ──
        Cmd->>Audit: write({action: 'apply_for_task', ...})
        Cmd->>Cache: deleteByPattern('task:*')
        Cmd->>Evt: emit('task:application:submitted', {...})

        Cmd-->>C: Proposal row
        C-->>User: 201 Created
    end
