%% Activity 03d — Review dispute across User and System realms
%% Evidence status: Implemented dispute governance; external AI advisory is Partial.
%% Keep reason: User participant, Suar handoff, System Admin, and AI lanes form one governed dispute transaction.
%% Updated: 2026-07-28.
%% Boundary: User stays on the Project board; only System Admin enters /admin/disputes.

flowchart LR
    subgraph user_realm["User realm · Project board"]
        direction TB
        Start(["Reviewee challenges result"]) --> Submit["Submit reason in card room"]
        Submit --> Exchange["Participants add comments/evidence"]
        Exchange --> Escalate{"Report unresolved case?"}
        Escalate -->|No| Exchange
        Escalate -->|Yes| Report["Move Project card to Reported"]
        Report --> ToSuar((A))
        FromSuarResult((D)) --> Read["Read final outcome on same card"] --> End([User-side flow complete])
    end

    subgraph suar["Suar realm handoff"]
        direction TB
        FromUser((A)) --> Case["Build case context and expose<br/>System Board 5 card"]
        Case --> ToSystem((B))
        FromSystemDecision((C)) --> Apply["Record decision/rationale<br/>update Project and System projections"]
        Apply --> ToUserResult((D))
    end

    subgraph system_realm["System realm · System Administration"]
        direction TB
        FromSuarCase((B)) --> Inspect["System Admin inspects case file"]
        Inspect --> Advisory{"Need AI advice?"}
        Advisory -->|No| Resolve["Make final human decision"]
        Advisory -->|Yes| AI["Start AI evaluation"]
        AI --> Advice["Read signed advisory result"]
        Advice --> Resolve
        Resolve --> ToSuarApply((C))
    end

    ToSuar ~~~ FromUser
    ToSystem ~~~ FromSuarCase
    ToSuarApply ~~~ FromSystemDecision
    ToUserResult ~~~ FromSuarResult

    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#1E1B4B,stroke-width:2px
    classDef action fill:#E3F2FD,stroke:#2563EB,color:#172554,stroke-width:2px
    classDef decision fill:#FFF7ED,stroke:#EA580C,color:#7C2D12,stroke-width:2px
    classDef ai fill:#F3E8FF,stroke:#7E22CE,color:#581C87,stroke-width:2px
    class Start,End startEnd
    class Submit,Exchange,Report,Read,Case,Apply,Inspect,Resolve action
    class Escalate,Advisory decision
    class AI,Advice ai
    classDef connector fill:#FFFFFF,stroke:#475569,color:#0F172A,stroke-width:2px
    class ToSuar,FromUser,ToSystem,FromSuarCase,ToSuarApply,FromSystemDecision,ToUserResult,FromSuarResult connector
    style user_realm fill:#EFF6FF,stroke:#2563EB,stroke-width:2px
    style suar fill:#F8FAFC,stroke:#94A3B8,stroke-width:2px
    style system_realm fill:#FFF7ED,stroke:#EA580C,stroke-width:2px
