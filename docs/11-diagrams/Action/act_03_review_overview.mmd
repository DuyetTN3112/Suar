%% act_03_review_overview.mmd
%% Updated 2026-07-10 (verified).
%% Reader intent: Understand review as a lifecycle from task completion-package handoff to acceptance, dispute, and downstream scoring.
%% Key boundary: Overview does not model every reviewer/reviewee/admin branch; those live in detail diagrams.
%% Current caveat: Review session can be opened before task reaches DONE; not every review event updates every metric immediately.
%% Confirmation, dispute resolution, and fraud handling trigger different recalculation paths.

flowchart TD
    Start([Start]) --> Module["Review module"]

    Module --> OpenSession["Open review session
    from completion package
    or DONE backstop path"]
    Module --> Submit["Submit manager / peer / self-linked review data"]
    Module --> Confirm["Confirm review\nor open dispute"]
    Module --> Score["Recalculate profile, trust,\nskill and performance aggregates"]

    OpenSession --> End([End])
    Submit --> End([End])
    Confirm --> End
    Score --> End

    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef process fill:#E3F2FD,stroke:#1565C0,color:#333
    class Start,End startEnd
    class Module,OpenSession,Submit,Confirm,Score process
