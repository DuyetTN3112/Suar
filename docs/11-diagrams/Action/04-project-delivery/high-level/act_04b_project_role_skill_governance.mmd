flowchart TB
    subgraph Row1[" "]
        direction LR
        Start([Owner opens Roles & Skills]) --> Role{"Role source"}
        Role -->|Template| Clone["Clone active role template<br/>and its skill requirements"]
        Role -->|Custom| Custom["Create project-specific role"]
        Clone --> Configure
        Custom --> Configure["Add project skills and rubric version"]
        Configure --> Levels["Set minimum, target,<br/>assessment ceiling, weight"] --> ToValidate((A))
        FromReject((B)) --> Configure
    end
    subgraph Row2[" "]
        direction LR
        FromLevels((A)) --> Valid{"Same scale and<br/>minimum ≤ target ≤ ceiling?"}
        Valid -->|No| Reject["Reject invalid level configuration"] --> ToConfigure((B))
        Valid -->|Yes| Save["Save role-skill contract<br/>and audit change"]
        Save --> Candidates["Request staffing candidates"]
        Candidates --> Score["Compare verified skill levels<br/>against weighted targets"]
        Score --> Explain["Return match score, gaps,<br/>evidence-source counts, confidence"]
        Explain --> End([Owner chooses staff])
    end
    ToValidate ~~~ FromLevels
    ToConfigure ~~~ FromReject

