%% Activity 04 — Project delivery across four shared boards
%% Evidence status: Implemented.
%% Updated 2026-07-28.
%% Level: Overview. Child diagrams: act_04c, act_01d, act_03e.

flowchart TB
    subgraph delivery[" "]
        direction LR
        Start([Project participants enter Project Workspace]) --> Task["Board 1 · Manage work on Task Board"]
        Task --> Done{"Task delivery reaches Done?"}
        Done -->|No| Task
        Done -->|Yes| Handoff["Keep task in Done<br/>create/project review card as awaiting_review"]
    end

    subgraph review_gate[" "]
        direction LR
        TaskReview["Board 2 · Complete Task Review workflow"] --> SprintGate{"Sprint review opens<br/>with task-review debt closed?"}
        SprintGate -->|No| TaskReview
        SprintGate -->|Yes| Fork{{Open sprint-close review work}}
    end

    subgraph reverse_review[" "]
        direction LR
        Assigner["Board 3 · Review assigner"] --> Join{{All required review work complete}}
        Environment["Board 4 · Review work environment"] --> Join
        Join --> End([Delivery and review evidence retained on boards])
    end

    Handoff --> TaskReview
    Fork --> Assigner
    Fork --> Environment
    style delivery fill:none,stroke:none
    style review_gate fill:none,stroke:none
    style reverse_review fill:none,stroke:none

    classDef terminal fill:#E8EAF6,stroke:#3F51B5,color:#333,stroke-width:2px
    classDef action fill:#E3F2FD,stroke:#1565C0,color:#333,stroke-width:2px
    classDef governed fill:#E8F5E9,stroke:#2E7D32,color:#333,stroke-width:2px
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333,stroke-width:2px
    class Start,End terminal
    class Task,Handoff action
    class TaskReview,Assigner,Environment governed
    class Done,SprintGate,Fork,Join decision
