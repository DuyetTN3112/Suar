%% act_03d_review_dispute_lifecycle.mmd — Review Dispute Lifecycle
%% Updated 2026-07-10.
%% Purpose: Full dispute flow from creation to resolution
%% Reader intent: Understand the full dispute path once a reviewee refuses a review outcome.
%% Key boundary: Dispute lifecycle only; happy-path scoring and anomaly moderation are outside this diagram.
%% Current caveat: Case-file build and AI evaluation belong to escalation/admin handling, not an unconditional auto-step immediately after dispute creation.
%% Excludes: Happy-path review scoring (see act_03c), anomaly detection (see state_06)
%% Related: create_review_dispute_command.ts, build_review_dispute_case_file_command.ts, start_ai_dispute_evaluation_command.ts, resolve_review_dispute_command.ts

flowchart TD
    Start([Dispute exists from reviewee action]) --> CreateDispute["Dispute creation path
    → ConfirmReviewCommand disputed path
      or CreateReviewDisputeCommand
    → review_disputes row created
    → status = 'pending'"]

    CreateDispute --> Exchange["RespondToReviewDisputeCommand
    → comments/evidences added
    → participants exchange
    → first valid response may move
      pending → collecting_evidence"]

    Exchange --> ReportAdmin{"Reviewee reports to admin?"}

    ReportAdmin -->|"No"| ContinueRoom["Dispute stays in room
    → more evidence / replies
    → not yet in admin handling"]

    ReportAdmin -->|"Yes, preconditions satisfied"| BuildCase["ReportReviewDisputeCommand
    → status = 'admin_reviewing'
    → escalation_reason stored
    → build case file
    → notify system admins"]

    BuildCase --> AIQueue["StartAiDisputeEvaluationCommand
    → Queue AI evaluation
    → only from admin handling
    → evaluation status = 'queued'
    → audit: queue_ai_dispute_evaluation"]

    AIQueue --> AICallback["External AI service processes
    → Returns signed callback
    → signed-request verification"]

    AICallback --> AISave["ProcessAiDisputeCallbackCommand
    → recommendation recorded
    → evaluation status = 'completed' or 'failed'
    → dispute may move
      ai_reviewing → admin_reviewing
    → AI is ADVISORY ONLY"]

    BuildCase --> AdminResolve{"Admin resolves dispute"}
    AISave --> AdminResolve

    AdminResolve -->|"Uphold review"| Uphold["resolve_review_dispute
    → final_decision = 'uphold_review'
    → Review stands
    → Scores remain"]

    AdminResolve -->|"Adjust score"| Overturn["resolve_review_dispute
    → final_decision = 'adjust_score'
    → Admin action may request
      profile recalculation"]

    AdminResolve -->|"Partial accept"| Partial["resolve_review_dispute
    → final_decision = 'partially_accept'
    → Admin action may request
      partial profile changes"]

    AdminResolve -->|"Re-review / dismiss"| Other["resolve_review_dispute
    → final_decision =
      'request_re_review' or
      'dismiss_dispute'"]

    %% ── Dispute timeline sources ──
    subgraph Timeline["Unified Dispute Timeline (admin)"]
        T1["audit_events
        (entity_type = review_dispute)"]
        T2["review_dispute_comments"]
        T3["review_dispute_evidences"]
        T4["review_dispute_case_files"]
        T5["ai_dispute_evaluations"]
    end

    AdminResolve --> End([End])

    %% ─── Styles ───
    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef process fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef ai fill:#F3E5F5,stroke:#6A1B9A,color:#333
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333
    classDef result fill:#E8F5E9,stroke:#2E7D32,color:#333

    class Start,End startEnd
    class CreateDispute,Exchange,BuildCase,AISave,ContinueRoom process
    class AIQueue,AICallback ai
    class AdminResolve decision
    class Uphold,Overturn,Partial,Other result
