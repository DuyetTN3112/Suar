%% ─────────────────────────────────────────────────────────────
%% Updated 2026-07-10 (verified).
%% act_02a: Marketplace Browse
%% ─────────────────────────────────────────────────────────────
%% Reader intent: Understand what a marketplace visitor can discover before sending a proposal.
%% Key boundary: Discovery-only view; no proposal mutation or organizer triage happens here.
%% Current caveat: Marketplace shows only externally visible task surfaces, not internal-only workspace tasks.
%% All routes require auth — NO guest/public browsing
%% Browse supports filtering/sorting; match score/ranking lives in sibling marketplace application surfaces.
%%
%% Related: act_02b_marketplace_apply.mmd — Proposal flow
%% ─────────────────────────────────────────────────────────────

    Start([Start]) --> BrowseMarketplace["External contributor opens
    GET /marketplace/tasks
    (requires auth, NO requireOrg)"]

    BrowseMarketplace --> ApplyFilters["GetPublicTasksQuery:
    Base filters:
    • visibility = external/all
    • assigned_to = NULL
    • deleted_at IS NULL

    Optional filters:
    • Skill IDs (whereHas)
    • Difficulty (exact match)
    • Sort: created_at/due_date"]

    ApplyFilters --> TaskList["Show task list
    + current_user_application
    (indicates if proposal already sent)"]

    TaskList --> ViewDetail["View task details
    GET /tasks/:id"]

    ViewDetail --> CheckApplied{"Already
    sent proposal?"}

    %% ─── Existing Proposal Path ───
    CheckApplied -->|Yes| ShowStatus["Show proposal
    status + details"]
    ShowStatus --> CanWithdraw{"Status =
    'pending'?"}
    CanWithdraw -->|Yes| WantWithdraw{"Want to
    withdraw?"}
    WantWithdraw -->|Yes| Withdraw["WithdrawMarketplaceApplicationCommand
    POST /applications/:id/withdraw
    → status = 'withdrawn'
    → applications_count -= 1"]
    WantWithdraw -->|No| End2([End])
    CanWithdraw -->|No| End2
    Withdraw --> End2

    %% ─── No Proposal → Go to Proposal flow ───
    CheckApplied -->|No| GoApply(["→ Continue:
    act_02b (Proposal)"])

    %% ─── Known Gaps ───
    %% Match score/ranking is handled by proposal-ranking/detail surfaces, not this browse diagram.
    %% ⚠️ Browse query already filters assigned_to = NULL and deleted_at IS NULL,
    %%    but this diagram does NOT prove every non-open business status is excluded.

    %% ─── Styles ───
    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef process fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333
    classDef error fill:#FFEBEE,stroke:#C62828,color:#333
    class Start,End2,GoApply startEnd
    class BrowseMarketplace,ApplyFilters,TaskList,ViewDetail,ShowStatus,Withdraw process
    class CheckApplied,CanWithdraw,WantWithdraw decision
