%% Activity 02b1 — Process marketplace proposal
%% Updated 2026-07-27.
%% Evidence status: Implemented.

flowchart TB
    subgraph Row1[" "]
        direction LR
        Start([Creator/owner/manager opens proposals]) --> Load["Load contributor proposal,<br/>profile and skill signals"]
        Load --> Authority{"May process this task?"}
        Authority -->|No| RejectAccess["Reject access"] --> EndRejected([Unchanged])
        Authority -->|Yes| Decision{"Decision"}
        Decision -->|Reject| ToReject((A))
        Decision -->|Approve| ToAvailable((B))
    end
    subgraph Row2[" "]
        direction LR
        FromReject((A)) --> Reject["Set rejected and retain reason"]
        FromApprove((B)) --> Available{"Task still unassigned?"}
        Available -->|No| RejectState["Reject stale approval"]
        Available -->|Yes| Assign["Approve proposal, create/sync<br/>active assignment, set assignee"]
        Assign --> Others["Reject other pending proposals"]
        Reject --> Effects["Audit and notify contributor"]
        Others --> Effects
        Effects --> End([Proposal state current])
        RejectState --> EndRejected
    end
    ToReject ~~~ FromReject
    ToAvailable ~~~ FromApprove

    classDef terminal fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef action fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333
    classDef write fill:#E8F5E9,stroke:#2E7D32,color:#333
    classDef error fill:#FFEBEE,stroke:#C62828,color:#333
    class Start,End,EndRejected terminal
    class Load action
    class Authority,Decision,Available decision
    class Reject,Assign,Others,Effects write
    class RejectAccess,RejectState error
    classDef connector fill:#FFFFFF,stroke:#475569,color:#0F172A,stroke-width:2px
    class ToReject,FromReject,ToAvailable,FromApprove connector
    style Row1 fill:transparent,stroke:transparent
    style Row2 fill:transparent,stroke:transparent
