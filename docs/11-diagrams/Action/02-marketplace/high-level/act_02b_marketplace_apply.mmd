%% Activity 02b — Submit marketplace proposal
%% Updated 2026-07-27.
%% Evidence status: Implemented.
%% Scope: contributor submission only. Organizer processing lives in act_02b1_marketplace_process_application.mmd.

flowchart LR
    Start([Contributor chooses task]) --> Guard{"Eligible proposal?"}
    Guard -->|Own task| Reject["Reject self-proposal"]
    Guard -->|Internal/not public| RejectVisibility["Reject non-marketplace task"]
    Guard -->|Assigned, duplicate,<br/>or deadline passed| RejectState["Return specific policy reason"]
    Guard -->|Allowed| Draft["Enter proposal message<br/>and portfolio links"]
    Draft --> Submit["Create pending task_application"]
    Submit --> Effects["Audit application and<br/>notify task creator"]
    Effects --> End([Proposal pending])
    Reject --> EndRejected([No proposal])
    RejectVisibility --> EndRejected
    RejectState --> EndRejected

