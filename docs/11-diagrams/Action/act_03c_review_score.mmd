%% ─────────────────────────────────────────────────────────────
%% Updated 2026-06-27.
%% Purpose: Score calculation + anomaly detection after review
%% Excludes: Review submission (see act_03a), confirm/dispute (see act_03b), dispute lifecycle (see act_03d)
%% Related: act_03a, act_03b, act_03d, seq_04c
%% ─────────────────────────────────────────────────────────────
%% Reader intent: Show two consequences after review activity: anomaly moderation and score recalculation.
%% Key boundary: Separates fraud-handling path from normal confirmed-score pipeline.
%% Current caveat: Reviewer credibility refresh and reviewee score refresh do not always happen on the same event branch.

flowchart TD
    %% ═══════════════════════════════════════════════════════════
    %% ANOMALY DETECTION (per review submission)
    %% ═══════════════════════════════════════════════════════════
    ReviewSubmitted(["Event: skill review submitted
    (from act_03a)"]) --> AnomalyCheck{"DetectAnomalyCommand:
    Anomaly detected?"}

    AnomalyCheck -->|"Yes"| CreateFlag["Create flagged_reviews row
    (flag_type + severity + notes)
    status = 'pending'"]
    CreateFlag --> AdminQueue["Flag appears in admin
    flagged review queue"]

    AnomalyCheck -->|"No"| AnomalyDone(["No anomaly — done"])

    %% ─── Admin resolves flagged review ───
    AdminQueue --> AdminResolve["Admin resolves:
    ResolveFlaggedReviewCommand"]
    AdminResolve --> AdminDecision{"Action?"}

    AdminDecision -->|"Dismissed"| DismissFlag["status = 'dismissed'
    Review stays, no change"]

    AdminDecision -->|"Confirmed"| ConfirmFraud["status = 'confirmed'
    → skill_review.is_fraud = true
    → RecalculateRevieweeSkillScoresCommand
    (exclude fraud reviews)"]

    DismissFlag --> FlagDone([End])
    ConfirmFraud --> FlagDone

    %% ═══════════════════════════════════════════════════════════
    %% SCORE CALCULATION (after session finalized/confirmed)
    %% ═══════════════════════════════════════════════════════════
    SessionFinalized(["From act_03b:
    review:confirmed
    action = 'confirmed'"]) --> RecalcSkills["RecalculateRevieweeSkillScoresCommand:
    Per user-skill:
    • Collect non-fraud skill reviews
      from completed sessions
      and disputed sessions without
      active review_disputes
    • weighted_score (credibility-weighted)
    • avg_percentage
    • confidence_score
    • Persist to user_skills"]

    RecalcSkills --> CalcPerf["CalculatePerformanceScoreCommand:
    On-time rate + completion rate
    + quality/difficulty/consistency"]

    CalcPerf --> CalcTrust["CalculateTrustScoreCommand:
    Delivery + quality + reliability"]

    CalcTrust --> Refresh["RefreshUserProfileAggregatesCommand:
    Work history + performance stats
    + domain expertise"]

    Refresh --> Cache["review_listener +
    skill:score:updated:
    invalidate profile/spider caches"]

    Cache --> Done(["Scores fully
    updated — End"])

    %% ─── Styles ───
    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef score fill:#E8F5E9,stroke:#2E7D32,color:#333
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333
    classDef flag fill:#FFF9C4,stroke:#F57F17,color:#333
    class ReviewSubmitted,SessionFinalized,AnomalyDone,FlagDone,Done startEnd
    class RecalcSkills,CalcPerf,CalcTrust,Refresh,Cache score
    class AnomalyCheck,AdminDecision decision
    class CreateFlag,AdminQueue,AdminResolve,DismissFlag,ConfirmFraud flag
