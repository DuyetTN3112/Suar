    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333
    classDef score fill:#F3E5F5,stroke:#6A1B9A,color:#333
    class Start startEnd
    class FetchRanking,LoadTask,LoadApps,LoadSkills,Loop,Render,OrganizerDecision process
    class CalcSkill,CalcDomain,CalcDelivery,CalcTrust,Overall,SourceCheck score
    class FitLabel decision
    class Strong,Good,Partial,Weak,SourcePM,SourceOrg,SourceExt score
