%% act_06b_logout_session_teardown.mmd
%% Updated 2026-07-10 (verified).
%% Reader intent: Understand how logout tears down authenticated web-session state in current runtime.
%% Key boundary: Logout/session teardown only; OAuth login and first-time account registration live in act_06_user_registration_approval.mmd and seq_01_auth.mmd.
%% Current caveat: Current runtime logout is session invalidation, not token revocation choreography across every support surface.
%% Runtime caveat: This file describes the normal web-session logout path, not dev/test-only support flows under /api/testing/*.
%% Backend: LogoutController.handle()
%% Session: AdonisJS session (cookie)

flowchart TD
    Start([Start]) --> Trigger["User clicks Logout"]
    Trigger --> Route["POST /logout
    or GET /logout"]
    Route --> Logout["auth.use('web').logout()"]
    Logout --> Cleanup["Forget session auth
    clear shared Inertia auth data"]
    Cleanup --> Emit["Emit user:logout event"]
    Emit --> Audit["Write audit/user-activity evidence"]
    Audit --> Redirect["Redirect /login
    with flash message"]
    Redirect --> End([End])

    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef process fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef session fill:#FFF9C4,stroke:#F57F17,color:#333
    classDef event fill:#E8F5E9,stroke:#2E7D32,color:#333

    class Start,End startEnd
    class Trigger,Route,Audit,Redirect process
    class Logout,Cleanup session
    class Emit event
