%% ─────────────────────────────────────────────────────────────
%% Updated 2026-07-10 (verified).
%% act_02b: Marketplace Proposal Submit (mid-level)
%% ─────────────────────────────────────────────────────────────
%% Purpose: Proposal submission → review → assignment happy path
%% Reader intent: Understand how a proposal enters the system and where organizer decisions branch off.
%% Key boundary: Main happy path only; exception and permission nuance live in sibling diagrams.
%% Current caveat: Runtime includes owner/manager processing paths when project role context is available.
%% Excludes: Withdraw (see act_02c), ranking (see act_02d), exceptions (see act_02e), permissions nuance (see seq_03d)
%% Related: act_02a_marketplace_browse.mmd, act_02c, act_02d, act_02e
%% ─────────────────────────────────────────────────────────────
%%
%% EVIDIENCE REFRESH 2026-06-26:
%% - deadline IS checked by canApplyForTask (technical policy name)
%% - canProcessApplication allows creator OR project owner/manager
%%   when project role context is wired through controller/query path
%%   (see risk-log R-01 and seq_03d for permission detail)

    Start(["From act_02a:
    User wants to send proposal"]) --> CanApply{"canApplyForTask:
    • Not own task?
    • visibility ∈ {external, all}?
    • Not already assigned?
    • Deadline not passed?
    • No duplicate proposal?"}

    CanApply -->|Denied| ShowDenied["Show policy denial
    with reason"]
    ShowDenied --> End1([End])

    CanApply -->|Allowed| FillApplication["Fill proposal:
    • message
    • portfolio_links"]

    FillApplication --> SubmitApplication["ApplyMarketplaceTaskCommand
    POST /api/v1/tasks/:taskId/apply
    → INSERT task_applications
    status = 'pending'
    (marketplace_applications parked)"]

    SubmitApplication --> AuditApply["Audit: apply_for_task
    + Notify task creator"]
    AuditApply --> End2([End])

    %% ═══════════════════════════════════════════════════════════
    %% REVIEW PROPOSALS
    %% ═══════════════════════════════════════════════════════════
    CreatorStart(["Task creator or
    project owner/manager
    opens proposals"]) --> ViewApps["GET /tasks/:taskId/applications
    → GetMarketplaceTaskApplicationsQuery
    (preloads contributor + skills)"]

    ViewApps --> ReviewApp["Review contributor proposal:
    • Profile + spider chart
    • Skills & levels
    • Cover letter
    • Match score"]

    ReviewApp --> ProcessDec{"Approve or reject proposal?"}

    ProcessDec -->|Approve| CreateAssignment["ProcessMarketplaceApplicationCommand:
    1. app.status = 'approved'
    2. Create/sync TaskAssignment
       (type, hours, status=active)
    3. task.assigned_to = contributor/applicant_id
    4. Reject other pending
       proposals for same task
    5. Audit + Notify"]
    CreateAssignment --> End3([End])

    ProcessDec -->|Reject| RejectApplication["ProcessMarketplaceApplicationCommand:
    1. app.status = 'rejected'
    2. rejection_reason = input
    3. Audit + Notify"]
    RejectApplication --> ViewApps

    %% ─── Policy Note ───
    %% canProcessApplication allows creator OR project owner/manager.
    %% Marketplace controller path must pass enough project role
    %% context for creator OR owner/manager processing.
    %% See risk-log R-01 and seq_03d for detail.

    %% ─── Styles ───
    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef process fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333
    classDef pm fill:#E8F5E9,stroke:#2E7D32,color:#333
    classDef error fill:#FFEBEE,stroke:#C62828,color:#333
    class Start,End1,End2,End3,CreatorStart startEnd
    class FillApplication,SubmitApplication,AuditApply process
    class CanApply,ProcessDec decision
    class ViewApps,ReviewApp,CreateAssignment,RejectApplication pm
    class ShowDenied error
