flowchart TD
    Start([Start]) --> Module["Organization membership module"]

    Module --> Create["Create organization"]
    Module --> Invite["Invite member"]
    Module --> Join["Approve / reject join request
    pending membership flow"]
    Module --> Role["Update member role"]

    Create --> End([End])
    Invite --> End
    Join --> End
    Role --> End

    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef process fill:#E3F2FD,stroke:#1565C0,color:#333
    class Start,End startEnd
    class Module,Create,Invite,Join,Role process
