%% ─────────────────────────────────────────────────────────────
%% Updated 2026-06-26 (verified).
%% act_07a: Profile Management
%% ─────────────────────────────────────────────────────────────
%% Reader intent: Understand how a user maintains profile presentation and sharing-ready identity details.
%% Key boundary: Profile-management only; deeper skill scoring and talent-search effects are separate concerns.
%% Current caveat: Snapshot publishing depends on profile state but is not the same as ordinary detail editing.
%%        View own / other user's profile
%%
%% Related active surfaces outside this file:
%%   - Skill CRUD → act_07b_skill_management.mmd
%%   - Reviewed skill recalculation → act_07c_reviewed_skill_recalculation.mmd
%%   - Talent bookmarks live on org talent bookmark routes/controllers
%%   - Snapshot publish/history/access/rotate-link flows are summarized here
%%
%% Backend: ProfileController → UserAction commands/queries
%% ─────────────────────────────────────────────────────────────

    Start([Start]) --> ProfileAction{"Action?"}

    %% ═══════════════════════════════════════════════════════════
    %% FLOW 1: Update Own Profile
    %% ═══════════════════════════════════════════════════════════
    ProfileAction -->|"Update Profile"| EditProfile["User opens
    GET /profile/edit"]
    EditProfile --> UpdateFields["Edit fields:
    bio, phone, address,
    timezone, language,
    avatar_url, is_external_contributor"]
    UpdateFields --> ValidateProfile{"Validate
    input?"}
    ValidateProfile -->|Invalid| ShowProfileErrors["Show validation
    errors"]
    ShowProfileErrors --> UpdateFields
    ValidateProfile -->|Valid| SaveProfile["PUT /profile/details
    → UpdateUserDetailsCommand
    UPDATE users SET ..."]
    SaveProfile --> AuditProfile["Log audit +
    invalidate cache
    user:profile:{userId}"]
    AuditProfile --> ProfileDone["Profile updated
    successfully"]
    ProfileDone --> End1([End])

    %% ═══════════════════════════════════════════════════════════
    %% FLOW 2: Publish and manage profile snapshots
    %% ═══════════════════════════════════════════════════════════
    ProfileAction -->|"Manage Snapshots"| SnapshotHome["Open current/history snapshot views"]
    SnapshotHome --> PublishSnapshot["POST /profile/snapshots/publish
    → PublishUserProfileSnapshotCommand"]
    PublishSnapshot --> SnapshotControls["Patch access level
    or rotate share link
    for selected snapshot"]
    SnapshotControls --> End2([End])

    %% ═══════════════════════════════════════════════════════════
    %% FLOW 3: View Other User's Profile
    %% ═══════════════════════════════════════════════════════════
    ProfileAction -->|"View Other User"| ViewOther["GET /users/:id/profile
    → ViewUserProfileController
    → GetUserProfileQuery (5min cache)"]
    ViewOther --> ShowPublic["Show public profile:
    • Bio, avatar, timezone
    • Spider chart (2-color)
    • Skills & levels
    • Trust score
    • is_external_contributor status"]
    ShowPublic --> End3([End])

    %% ─── Styles ───
    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef process fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333
    classDef error fill:#FFEBEE,stroke:#C62828,color:#333
    class Start,End1,End2,End3 startEnd
    class EditProfile,UpdateFields,SaveProfile,AuditProfile,ProfileDone,SnapshotHome,PublishSnapshot,SnapshotControls,ViewOther,ShowPublic process
    class ProfileAction,ValidateProfile decision
    class ShowProfileErrors error
