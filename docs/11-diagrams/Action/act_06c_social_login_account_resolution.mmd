%% act_06c_social_login_account_resolution.mmd
%% Updated 2026-07-10 (verified).
%% Reader intent: Understand SocialLoginCommand account-resolution cascade after OAuth provider already returned usable social data.
%% Key boundary: Account resolution only; redirect/callback transport lives in seq_01_auth.mmd and onboarding overview lives in act_06_user_registration_approval.mmd.
%% Current caveat: Persistence detail here is intentionally deeper than onboarding overview. Open only when concern is linking, duplicate identity, or first-time registration behavior.
%% Backend: SocialLoginCommand + SocialLoginPersistenceService

flowchart TD
    Start([Start]) --> Input["Receive provider + socialId
    + email + tokens"]

    Input --> Linked{"Linked provider
    record exists?"}

    Linked -->|Yes| LinkedUser["Load linked user
    + refresh provider tokens"]
    LinkedUser --> ExistingDone["Return existing user result
    + landing path"]

    Linked -->|No| EmailUser{"Existing user
    by email?"}

    EmailUser -->|Yes| LinkExisting["Link provider to
    existing user account
    + update auth_method if needed"]
    LinkExisting --> ExistingDone

    EmailUser -->|No| Register["Register new user
    in DB transaction"]
    Register --> CreateUser["Create active
    registered_user"]
    CreateUser --> CreateProvider["Create oauth provider record"]
    CreateProvider --> NewDone["Return new-user result
    + redirect /organizations"]

    ExistingDone --> End([End])
    NewDone --> End

    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef process fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333

    class Start,End startEnd
    class Input,LinkedUser,LinkExisting,Register,CreateUser,CreateProvider,ExistingDone,NewDone process
    class Linked,EmailUser decision
