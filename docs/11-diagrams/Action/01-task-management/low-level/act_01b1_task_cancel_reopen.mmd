%% Activity 01b1 — Cancel and reopen task
%% Updated 2026-07-27.
%% Evidence status: Implemented.

flowchart TB
    subgraph Row1[" "]
        direction LR
        Start([Task in TODO, IN_PROGRESS,<br/>or IN_REVIEW]) --> Cancel{"Authorized cancel?"}
        Cancel -->|No| Reject["Keep current workflow state"] --> ToUnchanged((B))
        Cancel -->|Yes| Cancelled["Move to CANCELLED"] --> ToReopen((A))
    end
    subgraph Row2[" "]
        direction LR
        FromCancelled((A)) --> Reopen{"Reopen requested?"}
        Reopen -->|No| EndCancelled([Remain cancelled])
        Reopen -->|Yes| Todo["Move to TODO"]
        Todo --> End([Ready for reassignment/work])
        FromRejected((B)) --> End
    end
    ToReopen ~~~ FromCancelled
    ToUnchanged ~~~ FromRejected

    classDef terminal fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333
    classDef state fill:#E8F5E9,stroke:#2E7D32,color:#333
    classDef error fill:#FFEBEE,stroke:#C62828,color:#333
    class Start,End,EndCancelled terminal
    class Cancel,Reopen decision
    class Cancelled,Todo state
    class Reject error
    classDef connector fill:#FFFFFF,stroke:#475569,color:#0F172A,stroke-width:2px
    class ToReopen,FromCancelled,ToUnchanged,FromRejected connector
    style Row1 fill:transparent,stroke:transparent
    style Row2 fill:transparent,stroke:transparent
