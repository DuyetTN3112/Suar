%% ─────────────────────────────────────────────────────────────
%% Updated 2026-06-26.
%% Purpose: Task assignment rules — internal, external contributor, marketplace paths
%% Reader intent: Clarify who can be assigned and which checks block assignment decisions.
%% Key boundary: Rule map only; repository writes and downstream task effects stay outside this diagram.
%% Current caveat: Assignment policy mixes org/project/task context, so one rejection may be caused by several adjacent guards.
%% Excludes: Status transitions (see act_01b), review trigger (see act_03)
%% Related: task_assignment_rules.ts, assign_task_command.ts, process_application_command.ts
%% ─────────────────────────────────────────────────────────────

flowchart TD
    Start([Assignment request]) --> AssignType{"Assignment type?"}

    %% ═══════════════════════════════════════════════════════════
    %% DIRECT ASSIGNMENT
    %% ═══════════════════════════════════════════════════════════
    AssignType -->|"Direct assign"| ValidateAssignee{"validateAssignee()"}

    ValidateAssignee -->|"isOrgMember = true"| AllowDirect["✅ Allow
    Org member can always
    be assigned"]

    ValidateAssignee -->|"external contributor = true"| CheckVis{"task_visibility?"}
    CheckVis -->|"external | all"| AllowExternalContributor["✅ Allow
    External contributor on public task"]
    CheckVis -->|"internal"| DenyExternalContributor["❌ Deny
    External contributor cannot be
    assigned to internal task"]

    ValidateAssignee -->|"Neither"| DenyNeither["❌ Deny
    Must be org member
    or external contributor"]

    %% ═══════════════════════════════════════════════════════════
    %% MARKETPLACE PROPOSAL PATH
    %% ═══════════════════════════════════════════════════════════
    AssignType -->|"Via marketplace
    proposal"| CanApply{"canApplyForTask()"}

    CanApply -->|"actor = creator"| DenySelf["❌ Cannot send proposal
    to own task"]
    CanApply -->|"visibility ≠ external/all"| DenyVis["❌ Task not
    publicly visible"]
    CanApply -->|"already assigned"| DenyAssigned["❌ Task already
    has assignee"]
    CanApply -->|"deadline passed"| DenyDeadline["❌ Proposal
    deadline passed"]
    CanApply -->|"duplicate"| DenyDupe["❌ Proposal already sent"]
    CanApply -->|"All checks pass"| AllowApply["✅ Proposal
    created (pending)"]

    %% ═══════════════════════════════════════════════════════════
    %% REVIEW PROPOSAL
    %% ═══════════════════════════════════════════════════════════
    AllowApply --> ProcessApp{"canProcessApplication()"}

    ProcessApp -->|"actor = creator OR
    project owner/manager"| CanApprove{"Action?"}
    CanApprove -->|"approve
    (if not assigned)"| CreateAssignment["Create TaskAssignment
    task.assigned_to = applicant
    Auto-reject other pending apps"]
    CanApprove -->|"reject"| SetReject["Record rejection_reason"]

    ProcessApp -->|"No authority"| DenyProcess["❌ Not authorized
    to review proposal"]

    %% ═══════════════════════════════════════════════════════════
    %% REVOKE ASSIGNMENT
    %% ═══════════════════════════════════════════════════════════
    AssignType -->|"Revoke"| CanRevoke{"canRevokeAssignment()"}
    CanRevoke -->|"status ≠ active"| DenyRevoke["❌ Only active
    assignments can be revoked"]
    CanRevoke -->|"reason empty"| DenyNoReason["❌ Reason required"]
    CanRevoke -->|"Active + reason"| RevokeOk["✅ Revoked
    assignment_status = 'revoked'"]

    %% ─── Styles ───
    classDef startEnd fill:#E8EAF6,stroke:#3F51B5,color:#333
    classDef decision fill:#FFF3E0,stroke:#E65100,color:#333
    classDef allow fill:#E8F5E9,stroke:#2E7D32,color:#333
    classDef deny fill:#FFEBEE,stroke:#C62828,color:#333
    classDef process fill:#E3F2FD,stroke:#1565C0,color:#333

    class Start startEnd
    class AssignType,ValidateAssignee,CheckVis,CanApply,ProcessApp,CanApprove,CanRevoke decision
    class AllowDirect,AllowExternalContributor,AllowApply,CreateAssignment,RevokeOk allow
    class DenyExternalContributor,DenyNeither,DenySelf,DenyVis,DenyAssigned,DenyDeadline,DenyDupe,DenyProcess,DenyRevoke,DenyNoReason,SetReject deny
