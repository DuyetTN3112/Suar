%% Activity 06a — OAuth provider authorization and callback
%% Evidence status: Implemented.
%% Updated 2026-07-27 (split from act_06_user_registration_approval).
%% Evidence: social login redirect and callback handlers for Google and GitHub.

flowchart TB
    subgraph Row1[" "]
        direction LR
        Start([User selects OAuth provider]) --> Redirect["Redirect to provider authorization endpoint"] --> Consent["Provider authenticates user and requests consent"] --> ToCallback((A))
    end
    subgraph Row2[" "]
        direction LR
        FromConsent((A)) --> Callback["Provider returns identity callback"] --> Validate{"State, provider identity, and email valid?"}
        Validate -->|No| Error["Return login error"] --> Failed([Authorization rejected])
        Validate -->|Yes| Identity["Return validated provider identity and tokens"] --> End([Continue to account resolution])
    end
    ToCallback ~~~ FromConsent

    classDef terminal fill:#E8EAF6,stroke:#3F51B5,color:#1E1B4B,stroke-width:2px
    classDef action fill:#E3F2FD,stroke:#2563EB,color:#172554,stroke-width:2px
    classDef decision fill:#FFF7ED,stroke:#EA580C,color:#7C2D12,stroke-width:2px
    classDef error fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D,stroke-width:2px
    class Start,Failed,End terminal
    class Redirect,Consent,Callback,Identity action
    class Validate decision
    class Error error
    classDef connector fill:#FFFFFF,stroke:#475569,color:#0F172A,stroke-width:2px
    class ToCallback,FromConsent connector
    style Row1 fill:transparent,stroke:transparent
    style Row2 fill:transparent,stroke:transparent
