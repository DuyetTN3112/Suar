        REDIS[("Redis<br/>session • cache • lock")]
        SEARCH["🔎 Elasticsearch 8.15<br/>candidate ids/ranking; SQL fallback"]
    end

    USERS -->|"authenticated requests and evidence"| SURFACES
    SURFACES -->|"pages, status, profile conclusions"| USERS
    ORGS -->|"membership and workflow policy"| GOVERN
