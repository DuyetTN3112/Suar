    ADMINS -->|"moderation and resolution"| GOVERN
    GOVERN -->|"case evidence and alerts"| ADMINS

    SURFACES <-->|"identity redirect/callback"| OAUTH
    GOVERN <-->|"signed trigger/callback<br/>advisory only"| CLAW
    CORE <-->|"transactional reads/writes"| PG
    CORE <-->|"session/cache/lock"| REDIS
    CORE <-->|"index/query when enabled"| SEARCH

    C1{{"⚠ Security<br/>CSP • CSRF • HSTS • scoped authorization"}}
    C2{{"⚠ Availability<br/>health checks for app, DB, Redis, search, resources"}}
    C3{{"⚠ Truthfulness<br/>Implemented ≠ Partial ≠ Planned"}}
    C4{{"⚠ Accountability<br/>AI advises; authorized human resolves"}}
    C1 -.-> GOVERN
    C2 -.-> CORE
    C3 -.-> CORE
    C4 -.-> GOVERN

    FUTURE["🔭 Planned<br/>dimension aggregation + full explainable matching"]
    FUTURE -.-> CORE

