%% uc_03b_review_lifecycle.mmd — Review Session Lifecycle
%% Updated 2026-07-10 (verified).
%% Mermaid approximation of a UML use case diagram.
%% Current caveat: Task-level reverse review submit is product-deprecated at current runtime.
%% Overdue session handling belongs to governance, but automatic force-close scheduling was not the strongest verified runtime path.

flowchart LR
    reviewer["<<actor>> Reviewer"]
    reviewee["<<actor>> Reviewee"]
    systemAdmin["<<actor>> System Admin"]
    scheduler["<<actor>> Scheduler"]

    subgraph system["Review Lifecycle"]
        submitSkill([Submit skill review])
        attachEvidence([Attach evidence])
        selfAssessment([Submit self-assessment])
        confirmResult([Confirm or dispute result])
        reverseReview([Legacy reverse review path])
        openDispute([Open dispute case])
        addDisputeEvidence([Add dispute evidence and comments])
        requestAiEval([Start AI dispute evaluation])
        myReviews([View my reviews])
        resolveFlag([Resolve flagged review])
        resolveDispute([Resolve dispute case file])
        expireSession([Handle overdue session])
    end

    reviewer --> submitSkill
    reviewer --> attachEvidence

    reviewee --> selfAssessment
    reviewee --> confirmResult
    reviewee -.-> reverseReview
    reviewee --> myReviews
    reviewee --> openDispute
    reviewee --> addDisputeEvidence

    systemAdmin --> resolveFlag
    systemAdmin --> requestAiEval
    systemAdmin --> resolveDispute
    scheduler --> expireSession

    attachEvidence -.->|<<extend>>| submitSkill
    reverseReview -.->|<<legacy extend>>| confirmResult
    openDispute -.->|<<extend>>| confirmResult
    addDisputeEvidence -.->|<<include>>| openDispute
    requestAiEval -.->|<<extend>>| openDispute

    classDef actor fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef usecase fill:#FFF3E0,stroke:#E65100,color:#333
    class reviewer,reviewee,systemAdmin,scheduler actor
    class submitSkill,attachEvidence,selfAssessment,confirmResult,reverseReview,openDispute,addDisputeEvidence,requestAiEval,myReviews,resolveFlag,resolveDispute,expireSession usecase
