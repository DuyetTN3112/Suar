%% uc_03a_marketplace_application.mmd — Marketplace Browse & Proposal
%% Updated 2026-06-26 (verified).
%% Mermaid approximation of a UML use case diagram.
%% Scope: current marketplace task discovery and proposal flow.
%% Note: invitation is a separate org/project workflow, not a marketplace assignment shortcut.

flowchart LR
    contributor["<<actor>> External Contributor / External User"]
    taskOwner["<<actor>> Task Creator / Project Owner / Project Manager"]

    subgraph system["Marketplace Proposal"]
        browse([Browse eligible public or external tasks])
        viewDetail([View task details and task contract context])
        submitApp([Submit task proposal])
        attachInfo([Attach message and portfolio links])
        withdrawApp([Withdraw pending proposal])
        myApps([View my proposals])
        reviewApps([Review task proposals])
        processApp([Approve or reject proposal])
        createAssign([Create assignment after approval])
        keepPrivate([Prevent private or internal task exposure])
    end

    contributor --> browse
    contributor --> viewDetail
    contributor --> submitApp
    contributor --> withdrawApp
    contributor --> myApps

    taskOwner --> reviewApps
    taskOwner --> processApp
    taskOwner --> createAssign

    submitApp -.->|<<include>>| attachInfo
    browse -.->|<<include>>| keepPrivate
    processApp -.->|<<include>>| reviewApps
    processApp -.->|<<include>>| createAssign

    classDef actor fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef usecase fill:#FFF3E0,stroke:#E65100,color:#333
    class contributor,taskOwner actor
    class browse,viewDetail,submitApp,attachInfo,withdrawApp,myApps,reviewApps,processApp,createAssign,keepPrivate usecase
