%% Conceptual ERD: High-Level Domain Model
%% Updated 2026-07-14 (Audit Fix)
%% Note: This diagram represents pure business domain concepts.
%% Physical DB does not enforce these via foreign keys.
erDiagram
    %% Core Entities
    ORGANIZATION {
        string name
        string plan
    }
    USER {
        string role
        string status
    }
    PROJECT {
        string status
        string visibility
    }
    TASK {
        string status
        string priority
    }
    EVIDENCE {
        string type
        string verification_status
    }
    REVIEW {
        string type
        int rating
    }
    SKILL {
        string category
    }
    PROFILE {
        string level
        json metrics
    }

    %% Relationships
    USER }|--o{ ORGANIZATION : "belongs to / manages"
    ORGANIZATION ||--o{ PROJECT : "owns"
    PROJECT ||--o{ TASK : "contains"
    USER }|--o{ TASK : "assigned to / completes"
    TASK ||--o{ EVIDENCE : "requires / validated by"
    USER ||--o{ EVIDENCE : "submits"
    TASK ||--o{ REVIEW : "evaluated via"
    USER ||--o{ REVIEW : "gives / receives"
    USER }|--o{ SKILL : "possesses / targets"
    USER ||--|| PROFILE : "represented by"
    SKILL ||--o{ REVIEW : "assessed in"
