%% ERD: Organization & Project Domain (Logical)
%% Updated 2026-07-14 (Audit Fix)
%% Note: The database does NOT enforce these relationships via physical Foreign Keys.
%% These are logical, application-enforced relationships.
erDiagram
    organizations {
        UUID id PK
        VARCHAR name
        VARCHAR slug UK
        TEXT description
        VARCHAR logo
        VARCHAR website
        VARCHAR plan
        UUID owner_id FK
        JSONB custom_roles
        VARCHAR partner_type "gold/silver/bronze"
        TIMESTAMPTZ partner_verified_at
        UUID partner_verified_by FK
        TEXT partner_verification_proof
        TIMESTAMPTZ partner_expires_at
        BOOLEAN partner_is_active
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    organization_users {
        UUID organization_id PK, FK
        UUID user_id PK, FK
        VARCHAR org_role "org_owner/org_admin/org_member"
        VARCHAR status "pending/approved/rejected"
        UUID invited_by FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    organization_invitations {
        UUID id PK
        UUID organization_id FK
        VARCHAR email
        VARCHAR org_role
        UUID invited_by FK
        VARCHAR token
        VARCHAR status "pending/accepted/expired"
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    organization_join_requests {
        UUID id PK
        UUID organization_id FK
        UUID user_id FK
        TEXT message
        VARCHAR status
        UUID reviewed_by FK
        TIMESTAMPTZ reviewed_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    projects {
        UUID id PK
        UUID creator_id FK
        VARCHAR name
        TEXT description
        UUID organization_id FK
        TIMESTAMPTZ start_date
        TIMESTAMPTZ end_date
        VARCHAR status "pending/in_progress/completed/cancelled"
        UUID manager_id FK
        UUID owner_id FK
        VARCHAR visibility "public/private/team"
        BOOLEAN allow_external_contributors
        BOOLEAN approval_required_for_members
        JSONB tags
        JSONB custom_roles
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    project_members {
        UUID project_id PK, FK
        UUID user_id PK, FK
        VARCHAR project_role "project_owner/project_manager/project_member/project_viewer"
        TIMESTAMPTZ created_at
    }

    project_sprints {
        UUID id PK
        UUID organization_id FK
        UUID project_id FK
        VARCHAR name
        TEXT goal
        VARCHAR status "draft/active/review_open/review_closed/archived"
        TIMESTAMPTZ starts_at
        TIMESTAMPTZ ends_at
        UUID created_by FK
        UUID closed_by FK
        TIMESTAMPTZ review_opened_at
        TIMESTAMPTZ review_closed_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    project_attachments {
        UUID id PK
        UUID project_id FK
        VARCHAR file_name
        VARCHAR file_path
        UUID uploaded_by FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% Application-enforced relationships
    organizations ||--o{ organization_users : "has members"
    organizations ||--o{ organization_invitations : "issues"
    organizations ||--o{ organization_join_requests : "receives"
    organizations ||--o{ projects : "owns"
    projects ||--o{ project_members : "has members"
    projects ||--o{ project_sprints : "plans"
    projects ||--o{ project_attachments : "has files"
    
    users ||--o{ organization_users : "is member of"
    users ||--o{ project_members : "is member of"
    users ||--o{ projects : "creates / manages"
    users ||--o{ organization_join_requests : "submits"
