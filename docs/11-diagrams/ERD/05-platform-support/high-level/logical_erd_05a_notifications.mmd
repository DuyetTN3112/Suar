%% Bounded platform-support slice for user notifications.

erDiagram
    direction LR
    USERS {
        UUID id PK
    }
    NOTIFICATIONS {
        UUID id PK
        UUID user_id FK
        VARCHAR type
        VARCHAR title
        TEXT message
        VARCHAR related_entity_type
