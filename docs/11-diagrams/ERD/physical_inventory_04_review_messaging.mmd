%% ERD: Review Domain + Legacy Messaging Tables
%% Updated 2026-07-16 (review workflow + sprint review inventory).
%% Review source: app/modules/reviews/infra/models/review_session.ts, skill_review.ts,
%%                reverse_review.ts, flagged_review.ts, review_evidence.ts;
%%                app/modules/tasks/infra/models/task_self_assessment.ts
%% Messaging source: legacy schema references
%% Convention: table/column only. No relationship edges or FK markers.
%% Reading mode: Dense low-level ERD slice. Open after review overview, not as first diagram for external readers.
%% Runtime notes:
%%   - review flow has evidence + self-assessment + reverse review + anomaly flags
%%   - task_review_* tables are storage-only workflow projections; application code owns rule validation
%%   - sprint_reverse_review_* tables are board/response state; submitted records still land in sprint_*_reviews
%%   - conversation/message app surface not fully present in current routes/controllers
%%   - flagged_reviews: 6 enum values declared in SQL; detect_anomaly_command currently checks bulk_same_level, new_account_high, mutual_high and documents ip_collusion as placeholder
erDiagram
    conversations {
        UUID id PK
        VARCHAR title
        UUID organization_id "nullable"
        UUID task_id "nullable - legacy"
        UUID last_message_id
        TIMESTAMPTZ last_message_at
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    conversation_participants {
        UUID id PK
        UUID conversation_id
        UUID user_id
    }

    messages {
        UUID id PK
        UUID conversation_id
        UUID sender_id
        TEXT message
        VARCHAR send_status "sending/sent/failed"
        BOOLEAN is_recalled
        TIMESTAMPTZ recalled_at
        VARCHAR recall_scope "self/all"
        TIMESTAMPTZ read_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    review_sessions {
        UUID id PK
        UUID task_assignment_id
        UUID reviewee_id
        VARCHAR status "pending/in_progress/completed/disputed"
        BOOLEAN manager_review_completed
        INT peer_reviews_count
        INT required_peer_reviews
        JSONB confirmations
        NUMERIC overall_quality_score
        VARCHAR delivery_timeliness
        NUMERIC requirement_adherence
        NUMERIC communication_quality
        NUMERIC code_quality_score
        NUMERIC proactiveness_score
        BOOLEAN would_work_with_again
        TEXT strengths_observed
        TEXT areas_for_improvement
        TIMESTAMPTZ deadline
        TIMESTAMPTZ completed_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    skill_reviews {
        UUID id PK
        UUID review_session_id
        UUID reviewer_id
        VARCHAR reviewer_type "manager/peer"
        UUID skill_id
        VARCHAR assigned_level_code "beginner~master"
        TEXT comment
        BOOLEAN is_fraud "default false"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    reverse_reviews {
        UUID id PK
        UUID review_session_id
        UUID reviewer_id
        VARCHAR target_type "peer/manager/project/organization"
        UUID target_id
        SMALLINT rating "1~5"
        TEXT comment
        BOOLEAN is_anonymous
        TIMESTAMPTZ created_at "ONLY timestamp - no updated_at"
    }

    flagged_reviews {
        UUID id PK
        UUID skill_review_id
        VARCHAR flag_type "sudden_spike/mutual_high/bulk_same_level/frequency_anomaly/new_account_high/ip_collusion"
        VARCHAR severity "low/medium/high/critical"
        VARCHAR status "pending/reviewed/dismissed/confirmed"
        TIMESTAMPTZ detected_at
        UUID reviewed_by
        TIMESTAMPTZ reviewed_at
        TEXT notes
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    review_evidences {
        UUID id PK
        UUID review_session_id
        VARCHAR evidence_type
        VARCHAR url
        VARCHAR title
        TEXT description
        UUID uploaded_by
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    task_self_assessments {
        UUID id PK
        UUID task_assignment_id
        UUID user_id
        NUMERIC overall_satisfaction
        VARCHAR difficulty_felt
        NUMERIC confidence_level
        TEXT what_went_well
        TEXT what_would_do_different
        JSONB blockers_encountered
        JSONB skills_felt_lacking
        JSONB skills_felt_strong
        TIMESTAMPTZ submitted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    task_review_workflows {
        UUID id PK
        UUID task_id
        UUID project_id
        UUID organization_id
        UUID reviewee_id
        VARCHAR status "awaiting_review/in_review/awaiting_response/disputed/reported/ai_reviewing/resolved/done"
        INT required_review_count
        INT completed_review_count
        TIMESTAMPTZ accepted_by_reviewee_at
        TIMESTAMPTZ reported_at
        UUID reported_by
        VARCHAR final_decision
        TEXT final_rationale
        TIMESTAMPTZ resolved_at
        UUID resolved_by
        TIMESTAMPTZ completed_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    task_review_reviewers {
        UUID id PK
        UUID workflow_id
        UUID reviewer_id
        VARCHAR reviewer_role
        BOOLEAN is_required
        VARCHAR status "pending/submitted"
        INT priority_rank
        TIMESTAMPTZ reviewed_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    task_review_messages {
        UUID id PK
        UUID workflow_id
        UUID author_id
        VARCHAR message_type "review/reviewee_response/system"
        TEXT body
        JSONB metadata
        TIMESTAMPTZ created_at
    }

    project_sprints {
        VARCHAR id PK
        VARCHAR organization_id
        VARCHAR project_id
        VARCHAR name
        TEXT goal "nullable Sprint Goal"
        VARCHAR status "draft/active/review_open/review_closed/archived"
        TIMESTAMPTZ starts_at
        TIMESTAMPTZ ends_at
        VARCHAR created_by
        VARCHAR closed_by
        TIMESTAMPTZ review_opened_at
        TIMESTAMPTZ review_closed_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    sprint_review_packages {
        VARCHAR id PK
        VARCHAR sprint_id
        VARCHAR reviewer_id
        VARCHAR status "pending/submitted/expired"
        TIMESTAMPTZ submitted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    sprint_manager_reviews {
        VARCHAR id PK
        VARCHAR package_id
        VARCHAR target_user_id
        VARCHAR target_role "manager/lead/assigner/owner"
        INT rating "1~5"
        JSONB dimensions
        TEXT comment
        BOOLEAN is_anonymous_to_target
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    sprint_environment_reviews {
        VARCHAR id PK
        VARCHAR package_id
        VARCHAR target_type "project/organization"
        VARCHAR target_id
        INT rating "1~5"
        JSONB dimensions
        TEXT comment
        BOOLEAN is_anonymous_publicly
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    sprint_review_disputes {
        VARCHAR id PK
        VARCHAR package_id
        VARCHAR opened_by
        VARCHAR status "pending/collecting_evidence/admin_reviewing/resolved/rejected/cancelled"
        TEXT dispute_reason
        VARCHAR requested_outcome
        TIMESTAMPTZ reported_to_admin_at
        VARCHAR reported_to_admin_by
        TEXT escalation_reason
        TIMESTAMPTZ resolved_at
        VARCHAR resolved_by
        VARCHAR final_decision
        TEXT final_rationale
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    sprint_review_dispute_comments {
        VARCHAR id PK
        VARCHAR dispute_id
        VARCHAR author_id
        TEXT body
        VARCHAR visibility "all_parties/admin_only"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    sprint_reverse_review_workflows {
        UUID id PK
        VARCHAR sprint_id
        UUID project_id
        UUID organization_id
        UUID reviewer_id
        VARCHAR target_type "assigner/environment"
        UUID target_user_id
        UUID target_entity_id
        UUID responder_id
        VARCHAR status "awaiting_review/in_review/awaiting_response/disputed/reported/ai_reviewing/resolved/done"
        INT rating "1~5 nullable"
        TEXT comment
        VARCHAR package_id
        TIMESTAMPTZ submitted_at
        TIMESTAMPTZ accepted_at
        TIMESTAMPTZ reported_at
        VARCHAR final_decision
        TEXT final_rationale
        TIMESTAMPTZ resolved_at
        UUID resolved_by
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    sprint_reverse_review_messages {
        UUID id PK
        UUID workflow_id
        UUID author_id
        VARCHAR message_type "review/accept/response/report"
        TEXT body
        JSONB metadata
        TIMESTAMPTZ created_at
    }
