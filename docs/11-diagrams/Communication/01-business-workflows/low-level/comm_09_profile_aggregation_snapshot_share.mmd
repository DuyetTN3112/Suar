%% Communication Diagram 09 — Profile aggregation, snapshot, and share
%% Updated: 2026-07-27 (code-verified).
%% Evidence status: Implemented.
%% Source: PublishProfileSnapshotController, PublishUserProfileSnapshotCommand, RefreshUserProfileAggregatesCommand.
%% Scenario: active profile owner publishes one immutable snapshot after current aggregates refresh.

flowchart BT
    subgraph request["Publish request"]
        direction LR
        O["Profile owner / public viewer<br/>:Actors"]
        C["PublishProfileSnapshotController<br/>:Controller"]
        P["PublishUserProfileSnapshotCommand<br/>:Control"]
        R["RefreshUserProfileAggregatesCommand<br/>:Control"]
    end
    subgraph persistence["Read model and publication"]
        direction LR
        PG[("PostgreSQL<br/>skills · work history · performance · snapshots")]
        A["AuditPublicApi + cacheStore<br/>:Post-commit collaborators"]
        V["GetPublicProfileSnapshotController<br/>GetPublicProfileSnapshotQuery<br/>:Boundary/control"]
    end

    O -->|"1: publishSnapshot(name, isPublic)"| C
    C -->|"1.1: handle(snapshotDto)"| P
    P -->|"1.1.1: enforce active account + rate limit"| PG
    P -->|"1.2: refreshAggregates(userId)"| R
    R -->|"1.2.1: rebuild work/performance/domain aggregates"| PG
    P -->|"1.3: load governed snapshot read model"| PG
    P -->|"1.4: unset current + insert immutable version/share token"| PG
    P -->|"1.5: write publish audit + invalidate cache after commit"| A
    P -.->|"2: snapshotId + version + shareableSlug"| C
    C -.->|"3: published snapshot"| O
    O -->|"4: readSharedSnapshot(slug/token)"| V
    V -->|"4.1: load public current snapshot"| PG

    classDef actor fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1
    classDef boundary fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C
    classDef control fill:#FFF8E1,stroke:#F9A825,stroke-width:2px,color:#5D4037
    classDef service fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    classDef db fill:#ECEFF1,stroke:#37474F,stroke-width:2px,color:#263238
    class O actor
    class C,V boundary
    class P,R control
    class A service
    class PG db
    style request fill:#F8FAFC,stroke:#94A3B8
    style persistence fill:#F8FAFC,stroke:#94A3B8
