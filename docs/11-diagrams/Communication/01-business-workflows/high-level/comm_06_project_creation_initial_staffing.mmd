%% Communication Diagram 06 — Project creation and initial staffing
%% Updated: 2026-07-27 (code-verified).
%% Evidence status: Implemented.
%% Source: CreateProjectWithStaffingController, CreateProjectCommand, SkillPublicApi, AddProjectMemberCommand, UpdateProjectMemberCommand.
%% Scenario: organization authority creates one project, clones selected role templates, and assigns initial staff.

flowchart BT
    subgraph request["Project request"]
        direction LR
        A["Organization owner/admin<br/>:Actor"]
        C["CreateProjectWithStaffingController<br/>:Controller"]
        P["CreateProjectCommand<br/>:Control"]
        PG[("PostgreSQL<br/>projects · members · audit_events")]
    end
    subgraph staffing["Role and staffing collaborators"]
        direction LR
        S["SkillPublicApi<br/>:Role-template service"]
        M["Add/UpdateProjectMemberCommand<br/>:Control"]
        E["Project event publishers<br/>:Post-commit collaborator"]
    end

    A -->|"1: createProject(project, templates, staffing)"| C
    C -->|"1.1: handle(projectDto)"| P
    P -->|"1.1.1: create project + owner membership + audit"| PG
    P -->|"1.1.2: publish projectCreated"| E
    P -.->|"1.2: project detail"| C
    C -->|"1.3*: cloneProfessionalRoleTemplate"| S
    S -->|"1.3.1*: persist project role + skills"| PG
    C -->|"1.4*: findProjectProfessionalRole"| S
    C -->|"1.5*: add/update member(roleId)"| M
    M -->|"1.5.1*: persist membership + audit"| PG
    M -->|"1.5.2*: publish memberAdded"| E
    C -.->|"2: redirect project workspace"| A

    classDef actor fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1
    classDef boundary fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C
    classDef control fill:#FFF8E1,stroke:#F9A825,stroke-width:2px,color:#5D4037
    classDef service fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    classDef db fill:#ECEFF1,stroke:#37474F,stroke-width:2px,color:#263238
    class A actor
    class C boundary
    class P,M control
    class S,E service
    class PG db
    style request fill:#F8FAFC,stroke:#94A3B8
    style staffing fill:#F8FAFC,stroke:#94A3B8
