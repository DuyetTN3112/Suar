%% DFD 01a - Identity & Access detail (Level 2 for P1)
%% Reader intent: Decompose the Level-1 Identity & Access process into auth/session/account data movement.
%% Boundary: This is a development evidence DFD, not a full IAM/security architecture certification.

flowchart TD
    User([User])
    OAuth([OAuth Provider])

    P11[["1.1 Receive login/profile request"]]
    P12[["1.2 Resolve OAuth identity"]]
    P13[["1.3 Bootstrap or update account"]]
    P14[["1.4 Issue web session"]]
    P15[["1.5 Resolve current organization context"]]

    D1[(PostgreSQL users and identity records)]
    D2[(PostgreSQL organization membership records)]
    D3[(Redis/web session store)]

    User -->|"login/profile request"| P11
    P11 -->|"OAuth redirect request"| OAuth
    OAuth -->|"OAuth identity callback"| P12
    P12 -->|"verified identity attributes"| P13
    P13 -->|"user account profile data"| D1
    P13 -->|"authenticated user id"| P14
    P14 -->|"session token and flash state"| D3
    P14 -->|"session context"| P15
    P15 -->|"membership lookup request"| D2
    D2 -->|"current organization membership state"| P15
    P15 -->|"authenticated context response"| User

    classDef entity fill:#E3F2FD,stroke:#1565C0,color:#333,stroke-width:2px
    classDef process fill:#FFF9C4,stroke:#F57F17,color:#333,stroke-width:2px
    classDef datastore fill:#E8F5E9,stroke:#2E7D32,color:#333,stroke-width:2px
    class User,OAuth entity
    class P11,P12,P13,P14,P15 process
    class D1,D2,D3 datastore
