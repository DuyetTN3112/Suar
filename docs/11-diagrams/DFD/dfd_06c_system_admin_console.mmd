%% DFD 06C - System Admin Console
%% Reader intent: Understand the core stores the admin console reads and mutates during governance work.
%% Key boundary: Admin-console view only; notification and user-settings support flows are separate.
%% Current caveat: Dashboard reads, moderation, and flagged-review resolution share an admin surface but do not all use the same operational path.

flowchart TD
    Admin([System Admin])

    P1[["Toggle admin mode"]]
    P2[["Load dashboard aggregates"]]
    P3[["Moderate users / roles"]]
    P4[["Resolve flagged reviews"]]

    D1[(users)]
    D2[(flagged_reviews)]
    D3[(audit_events
    audit_event_scopes)]
    D4[(admin session state)]

    Admin -->|"Admin Input"| P1
    Admin -->|"Admin Input"| P2
    Admin -->|"Admin Input"| P3
    Admin -->|"Admin Input"| P4

    P1 -->|"System Data"| D4
    P2 -->|"System Data"| D1
    P2 -->|"System Data"| D2
    P3 -->|"System Data"| D1
    P3 -->|"System Data"| D3
    P4 -->|"System Data"| D2
    P4 -->|"System Data"| D3

    classDef entity fill:#E3F2FD,stroke:#1565C0,color:#333,stroke-width:2px
    classDef process fill:#FFF9C4,stroke:#F57F17,color:#333,stroke-width:2px
    classDef datastore fill:#E8F5E9,stroke:#2E7D32,color:#333,stroke-width:2px
    class Admin entity
    class P1,P2,P3,P4 process
    class D1,D2,D3,D4 datastore
