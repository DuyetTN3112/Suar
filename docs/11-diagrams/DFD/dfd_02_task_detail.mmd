%% DFD 02 — Task Management Overview
%% Updated 2026-07-10 (verified).
%% Reader intent: Understand task management as a data-flow surface spanning authoring, workflow execution, completion package, and board visibility.
%% Key boundary: This overview groups the task concern only; authoring, execution, and completion-package details split into child DFDs.
%% Current caveat: Marketplace and review touch task data but remain adjacent domains, not part of the task DFD's core ownership.

flowchart TD
    PM([Project Manager])
    MEM([Project Member])
    MKT([Marketplace])
    REV([Review])

    P1[[Author Task]]
    P2[[Execute Task Workflow]]
    P3[[Maintain Completion Package]]
    P4[[View Task Board and Detail]]

    D1[(tasks)]
    D2[(task_versions)]
    D3[(task_assignments)]
    D4[(task_required_skills)]
    D5[(task_statuses)]
    D6[(task_workflow_transitions)]
    D7[(task_submissions / comments / attachments)]

    PM -->|"PM Input"| P1
    PM -->|"PM Input"| P2
    MEM -->|"MEM Input"| P2
    PM -->|"PM Input"| P3
    MEM -->|"MEM Input"| P3
    PM -->|"PM Input"| P4
    MEM -->|"MEM Input"| P4

    P1 -->|"Task Data"| D1
    P1 -->|"Task Data"| D2
    P1 -->|"Task Data"| D4
    P1 -->|"Task Data"| D5
    P2 -->|"Task Data"| D1
    P2 -->|"Task Data"| D3
    P2 -->|"Task Data"| D6
    P2 -->|"Task Update"| REV
    P2 -->|"Task Update"| MKT
    P3 -->|"Task Data"| D1
    P3 -->|"Task Data"| D3
    P3 -->|"Task Data"| D7
    P3 -->|"Task Update"| REV
    P4 -->|"Task Data"| D1
    P4 -->|"Task Data"| D2
    P4 -->|"Task Data"| D3
    P4 -->|"Task Data"| D7

    classDef entity fill:#E3F2FD,stroke:#1565C0,color:#333
    classDef process fill:#FFF9C4,stroke:#F57F17,color:#333
    classDef datastore fill:#E8F5E9,stroke:#2E7D32,color:#333
    classDef external fill:#F3E5F5,stroke:#7B1FA2,color:#333
    class PM,MEM entity
    class P1,P2,P3,P4 process
    class D1,D2,D3,D4,D5,D6,D7 datastore
    class MKT,REV external
