%% Updated 2026-06-26. Last verified for header consistency.
%% DFD 05A — Organization Membership
%% Reader intent: Understand the data stores behind organization entry and membership onboarding.
%% Key boundary: Membership-entry flow only; later member governance and org settings live in the admin-controls DFD.
%% Current caveat: Invite and join-request paths can use different storage shapes while still converging on active organization membership.

flowchart TD
    User([User])
    Admin([Org Owner / Org Admin])

    P1[["Create Organization"]]
    P2[["Invite Member"]]
    P3[["Join Request"]]
    P4[["Approve / Reject Join Request"]]

    D1[(users)]
    D2[(organizations)]
    D3[(organization_users)]
    D4[(organization_invitations
    or equivalent access storage)]
    D5[(audit_events
    audit_event_scopes)]

    User -->|"User Input"| P1
    Admin -->|"Admin Input"| P2
    User -->|"User Input"| P3
    Admin -->|"Admin Input"| P4

    P1 -->|"Org Data"| D1
    P1 -->|"Org Data"| D2
    P1 -->|"Org Data"| D3
    P1 -->|"Org Data"| D5
    P2 -->|"Org Data"| D3
    P2 -->|"Org Data"| D4
    P2 -->|"Org Data"| D5
    P3 -->|"Org Data"| D3
    P3 -->|"Org Data"| D5
    P4 -->|"Org Data"| D3
    P4 -->|"Org Data"| D5

    classDef entity fill:#E3F2FD,stroke:#1565C0,color:#333,stroke-width:2px
    classDef process fill:#FFF9C4,stroke:#F57F17,color:#333,stroke-width:2px
    classDef datastore fill:#E8F5E9,stroke:#2E7D32,color:#333,stroke-width:2px
    class User,Admin entity
    class P1,P2,P3,P4 process
    class D1,D2,D3,D4,D5 datastore
