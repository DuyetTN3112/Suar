%% DFD 00 — Context Diagram (Level 0)
%% Updated 2026-07-14 (Audit Fix)
%% ❌ Removed: Internal Data Stores (PostgreSQL, Redis) from Context Level
%% ✅ Fixed: Data flows use standard English noun phrases
%% ✅ Architecture: Modular monolith with Clean Architecture layers
flowchart LR
    %% ═══════════════════════════════
    %% LEFT: External Entities (Actors)
    %% ═══════════════════════════════
    subgraph ext[" External Entities"]
        direction TB
        U([ User / Employee])
        FL([ External Contributor])
        ADM([ System Admin])
    end

    %% ═══════════════════════════════
    %% CENTER: Core System
    %% ═══════════════════════════════
    subgraph sys[" SUAR SYSTEM"]
        SUAR[" HR & Project Management System SUAR
         ───────────────────────────────
         Organization & Member Management
         Project & Task Management
         Public Task Marketplace
         360° Review & Spider Chart
         Notifications & Settings
         Skill Management & Profiles"]
    end

    %% ═══════════════════════════════
    %% RIGHT TOP: External Services
    %% ═══════════════════════════════
    subgraph svc[" External Services"]
        direction TB
        OAuth([ OAuth Provider\nGoogle / GitHub])
    end

    %% ═══════════════════════════════
    %% FLOWS — User
    %% ═══════════════════════════════
    U -->|"Auth Req & Profile Data"| SUAR
    U -->|"Project & Task Input"| SUAR
    SUAR -->|"Dashboard & Notifications"| U

    %% ═══════════════════════════════
    %% FLOWS — External contributor
    %% ═══════════════════════════════
    FL -->|"Proposals & Task Queries"| SUAR
    SUAR -->|"Review & Rating Data"| FL

    %% ═══════════════════════════════
    %% FLOWS — Admin
    %% ═══════════════════════════════
    ADM -->|"Moderation Config"| SUAR
    SUAR -->|"Reports & Alerts"| ADM

    %% ═══════════════════════════════
    %% FLOWS — External Services
    %% ═══════════════════════════════
    SUAR -->|"Auth Request"| OAuth
    OAuth -->|"User Info & Session"| SUAR

    %% ═══════════════════════════════
    %% STYLES
    %% ═══════════════════════════════
    classDef entity   fill:#DBEAFE,stroke:#2563EB,color:#1e3a8a,stroke-width:2px
    classDef system   fill:#FEF3C7,stroke:#D97706,color:#78350f,stroke-width:3px
    classDef service  fill:#EDE9FE,stroke:#7C3AED,color:#3b0764,stroke-width:2px

    class U,FL,ADM entity
    class SUAR system
    class OAuth service

    style ext   fill:#EFF6FF,stroke:#BFDBFE,stroke-width:1.5px,color:#1e40af
    style sys   fill:#FFFBEB,stroke:#FDE68A,stroke-width:2px,color:#92400e
    style svc   fill:#F5F3FF,stroke:#DDD6FE,stroke-width:1.5px,color:#4c1d95
