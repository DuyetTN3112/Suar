%% DFD 04 — Review Domain Overview
%% Updated 2026-06-26 (verified).
%% Reader intent: Understand where review data originates, who can change it, and which stores hold moderation and scoring outcomes.
%% Key boundary: Overview covers the review domain as one data-flow map; submission, confirmation, scoring, and reverse feedback split into child DFDs.
%% Current caveat: Review data continues beyond one submission because disputes, fraud moderation, and score refreshes can reopen downstream processing.

flowchart TD
    Reviewer([Reviewer])
    Reviewee([Reviewee])
    Admin([System Admin])
    TaskFlow([Task completion event])

    P1[["4.1 Session Creation"]]
    P2[["4.2 Review Submission"]]
    P3[["4.3 Moderation & Confirmation"]]
    P4[["4.4 Scoring & Feedback"]]

    D1[(review_sessions)]
    D2[(skill_reviews)]
    D3[(flagged_reviews)]
    D4[(reverse_reviews)]
    D5[(review_evidences)]
    D6[(task_self_assessments)]
    D7[(user aggregates)]

    TaskFlow -->|"Action Request"| P1
    Reviewer -->|"Reviewer Input"| P2
    Reviewee -->|"Reviewee Input"| P3
    Admin -->|"Admin Input"| P3
    Reviewee -->|"Reviewee Input"| P4

    P1 -->|"Review Data"| D1
    P2 -->|"Review Data"| D1
    P2 -->|"Review Data"| D2
    P2 -->|"Review Data"| D5
    P3 -->|"Review Data"| D1
    P3 -->|"Review Data"| D3
    P4 -->|"Review Data"| D4
    P4 -->|"Review Data"| D6
    P4 -->|"Review Data"| D7

    classDef entity fill:#E3F2FD,stroke:#1565C0,color:#333,stroke-width:2px
    classDef process fill:#FFF9C4,stroke:#F57F17,color:#333,stroke-width:2px
    classDef datastore fill:#E8F5E9,stroke:#2E7D32,color:#333,stroke-width:2px
    class Reviewer,Reviewee,Admin,TaskFlow entity
    class P1,P2,P3,P4 process
    class D1,D2,D3,D4,D5,D6,D7 datastore
