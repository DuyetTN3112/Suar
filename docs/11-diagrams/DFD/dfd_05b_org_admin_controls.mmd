%% DFD 05B — Organization Admin Controls
%% Reader intent: Understand which organization-owned stores are touched by admin-side governance actions.
%% Key boundary: Admin-controls view only; initial org creation and join-entry flow are separate.
%% Current caveat: Context switching and settings sit beside membership governance because they share organization authority, even though they are different user intents.

flowchart TD
    Admin([Org Owner / Org Admin])

    P1[["List Members / Pending Requests"]]
    P2[["Update Member Role"]]
    P3[["Remove Member"]]
    P4[["Switch Organization Context"]]
    P5[["Update Organization Settings"]]

    D1[(users)]
    D2[(organizations)]
    D3[(organization_users)]
    D4[(audit_events
    audit_event_scopes)]

    Admin -->|"Admin Input"| P1
    Admin -->|"Admin Input"| P2
    Admin -->|"Admin Input"| P3
    Admin -->|"Admin Input"| P4
    Admin -->|"Admin Input"| P5

    P1 -->|"Org Data"| D1
    P1 -->|"Org Data"| D3
    P2 -->|"Org Data"| D3
    P2 -->|"Org Data"| D4
    P3 -->|"Org Data"| D3
    P3 -->|"Org Data"| D4
    P4 -->|"Org Data"| D1
    P4 -->|"Org Data"| D4
    P5 -->|"Org Data"| D2
    P5 -->|"Org Data"| D4

    classDef entity fill:#E3F2FD,stroke:#1565C0,color:#333,stroke-width:2px
    classDef process fill:#FFF9C4,stroke:#F57F17,color:#333,stroke-width:2px
    classDef datastore fill:#E8F5E9,stroke:#2E7D32,color:#333,stroke-width:2px
    class Admin entity
    class P1,P2,P3,P4,P5 process
    class D1,D2,D3,D4 datastore
