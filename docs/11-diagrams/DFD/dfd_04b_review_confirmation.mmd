%% Updated 2026-06-26. Last verified for header consistency.
%% DFD 04B — Review Confirmation and Moderation
%% Reader intent: Understand which review stores are touched when a review is confirmed, disputed, or moderated.
%% Key boundary: Confirmation/moderation only; original submission and later score recalculation are separate flows.
%% Current caveat: Reviewee dispute and admin anomaly handling both affect review-state interpretation, even though they start from different actors.

flowchart TD
    Reviewee([Reviewee])
    Admin([System Admin])

    P1[["4B.1 Detect / inspect anomaly"]]
    P2[["4B.2 Confirm or dispute review"]]

    D1[(review_sessions)]
    D2[(skill_reviews)]
    D3[(flagged_reviews)]

    Admin -->|"Admin Input"| P1
    P1 -->|"Review Data"| D2
    P1 -->|"Review Data"| D3

    Reviewee -->|"Reviewee Input"| P2
    P2 -->|"Review Data"| D1
    P2 -->|"Review Data"| D2
    P2 -->|"Review Data"| D3

    classDef entity fill:#E3F2FD,stroke:#1565C0,color:#333,stroke-width:2px
    classDef process fill:#FFF9C4,stroke:#F57F17,color:#333,stroke-width:2px
    classDef datastore fill:#E8F5E9,stroke:#2E7D32,color:#333,stroke-width:2px
    class Reviewee,Admin entity
    class P1,P2 process
    class D1,D2,D3 datastore
