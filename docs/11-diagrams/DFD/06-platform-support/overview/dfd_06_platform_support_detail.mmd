%% DFD 06 — Platform-support map (Formal Level 2: expansion of P7)
%% Parent process: P7 Deliver support from complementary Level-1 frame dfd_01d_platform_support.
%% Evidence status: Implemented.
%% Balance: refines governance/support input and preserves the audit and delivery result at the external boundary.
%% Repeated E1, E3, runtime, and D5 symbols are the same boundary/store shown in separate lanes to keep the independent flows readable.
%% Direction: arrowhead marks the recipient. Store-to-process flows supply current facts; process-to-store flows persist updated facts.

%%{init: {"flowchart": {"curve": "stepAfter", "nodeSpacing": 32, "rankSpacing": 52}} }%%

flowchart TB
    subgraph member_support["Member-facing support functions"]
        direction LR
        subgraph notifications["Notification lane"]
            direction LR
            U1I["E1<br/>Authenticated member"] -->|"notification request"| P1[[7.1 Notification center]]
            D5N[("D5<br/>Platform-support records")] -->|"current owned notification state"| P1
            P1 -->|"updated read/deletion state"| D5N
            P1 -->|"notification result"| U1O["E1<br/>same actor"]
        end

        subgraph settings["Settings lane"]
            direction LR
            U2I["E1<br/>same actor"] -->|"settings request"| P2[[7.2 User settings]]
            D5S[("D5<br/>same logical store")] -->|"current settings and profile state"| P2
            P2 -->|"updated preferences and identity"| D5S
            P2 -->|"settings result"| U2O["E1<br/>same actor"]
        end
    end

    subgraph operational_support["Operational support functions"]
        direction LR
        subgraph administration["Administration lane"]
            direction LR
            A1I["E3<br/>System administrator"] -->|"platform governance request"| P3[[7.3 Administration console]]
            D5A[("D5<br/>same logical store")] -->|"current users, reviews, audit queues"| P3
            P3 -->|"updated governance and audit state"| D5A
            P3 -->|"governance result"| A1O["E3<br/>same actor"]
        end

        subgraph errors["Runtime-error lane"]
            direction LR
            X1I["Internal application runtime"] -->|"caught failure context"| P4[[7.4 Capture error]]
            P4 -->|"reportable error record"| D5E[("D5<br/>same logical store")]
            P4 -->|"safe error result"| X1O["Internal application runtime"]
        end
    end

    classDef entity fill:#E3F2FD,stroke:#2563EB,color:#172554,stroke-width:2px
    classDef process fill:#FFF7ED,stroke:#EA580C,color:#7C2D12,stroke-width:2px
    classDef store fill:#ECFDF5,stroke:#059669,color:#064E3B,stroke-width:2px
    class U1I,U1O,U2I,U2O,A1I,A1O entity
    class P1,P2,P3,P4 process
    class D5N,D5S,D5A,D5E store
    classDef handoff fill:#F8FAFC,stroke:#64748B,color:#0F172A,stroke-width:2px
    class X1I,X1O handoff
    style notifications fill:#F8FAFC,stroke:#94A3B8
    style settings fill:#F8FAFC,stroke:#94A3B8
    style administration fill:#F8FAFC,stroke:#94A3B8
    style errors fill:#F8FAFC,stroke:#94A3B8
