%% Architecture Diagram: System Overview
%% Updated 2026-07-17 (verified) from current backend and multi-app frontend structure.

flowchart TD
    subgraph client["Client Layer"]
        Browser["Browser\nSvelte + Inertia"]
        UserApp["User app\ninertia/apps/user"]
        OrgApp["Organization app\ninertia/apps/org"]
        AdminApp["System admin app\ninertia/apps/admin"]
        UserSurface["User workspace\nroot routes"]
        AdminSurface["System Admin\n/admin/*"]
        OrgSurface["Organization workspace\n/org/*"]
    end

    subgraph server["AdonisJS Application Server"]
        Http["Routes + Middleware + Controllers"]
        Actions["Action Layer\nCQRS commands/queries\nmodule public APIs"]
        Bootstrap["Bootstrap Layer\ncomposition root\naction factory\nmonolith adapters"]
        Application["Application Layer\nactor contexts, ports\nDTOs, mappers, services"]
        Domain["Domain Layer\nentities, formulas\npolicies, state rules"]
        Infra["Infrastructure Layer\nrepositories, mappers\ncache/logger adapters"]
        Events["Events + Listeners\nactivity, audit, notification\ncache invalidation"]
    end

    subgraph data["Data Layer"]
        PG[("PostgreSQL\ncore business data")]
        PgOps[("PostgreSQL\noperational stores\naudit_events / audit_event_scopes\nerror_events / notifications / user_activity")]
        Redis[("Redis\nsessions, locks, app cache")]
    end

    subgraph external["External Runtime"]
        OAuth["OAuth Providers\nGoogle + GitHub"]
        Realtime["Transmit / realtime\nconfigured with transport=null"]
    end

    Browser --> UserApp
    Browser --> OrgApp
    Browser --> AdminApp
    UserApp --> UserSurface
    OrgApp --> OrgSurface
    AdminApp --> AdminSurface
    UserSurface --> Http
    AdminSurface --> Http
    OrgSurface --> Http

    Http --> Actions
    Actions --> Bootstrap
    Bootstrap --> Application
    Application --> Domain
    Application --> Infra
    Infra --> PG
    Infra --> PgOps
    Infra --> Redis

    Actions --> Events
    Events --> Actions
    Events --> Infra
    Events -.-> Realtime

    Http --> OAuth
    OAuth --> Http

    classDef clientStyle fill:#E3F2FD,stroke:#1565C0,color:#333,stroke-width:2px
    classDef serverStyle fill:#FFF9C4,stroke:#F57F17,color:#333,stroke-width:2px
    classDef bootstrapStyle fill:#FCE4EC,stroke:#C62828,color:#333,stroke-width:2px
    classDef dataStyle fill:#E8F5E9,stroke:#2E7D32,color:#333,stroke-width:2px
    classDef extStyle fill:#F3E5F5,stroke:#7B1FA2,color:#333,stroke-width:2px
    class Browser,UserApp,OrgApp,AdminApp,UserSurface,AdminSurface,OrgSurface clientStyle
    class Http,Actions,Domain,Infra,Events serverStyle
    class Bootstrap bootstrapStyle
    class PG,PgOps,Redis dataStyle
    class OAuth,Realtime extStyle
