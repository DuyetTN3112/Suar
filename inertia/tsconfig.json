{
  "extends": "@adonisjs/tsconfig/tsconfig.client.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,

    /* 🚨 STRICT MODE - Kiểm tra nghiêm ngặt */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    /* 🔍 Kiểm tra bổ sung - Code quality */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "*": ["./*"],
      "@/*": ["./*"],
      "@lib/*": ["./apps/user/shared/lib/*"],
      "$lib/*": ["./apps/user/shared/lib/*"],
      "$lib": ["./apps/user/shared/lib"],
      "@shared/*": ["./apps/user/shared/*"],
      "@modules/*": ["./apps/user/modules/*"],
      "~/generated/*": ["./generated/*"]
    },
    "types": ["vite/client", "@testing-library/jest-dom"]
  },
  "files": ["./app.d.ts", "./types/qrcode.d.ts"],
  "include": ["./**/*.ts", "./**/*.svelte", "../types/**/*.d.ts"],
  "exclude": [
    "./**/*.d.ts",
    "./**/*.js",
    "./tests/ui/testWrappers/**/*",
    "node_modules",
    "build"
  ]
}
