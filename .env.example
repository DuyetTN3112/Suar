TZ=
PORT=
HOST=
LOG_LEVEL=info
APP_KEY=
NODE_ENV=
APP_URL=http://localhost:3333
SESSION_DRIVER=redis
DB_CONNECTION=
# PostgreSQL and Redis are independently operated services. The Docker files in
# this repository are not the source of truth for either service.
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Main-Redis tests use explicit local DB14. Cache tests below require a physically
# separate endpoint; Redis Cluster supports DB0 only and needs separate services.
REDIS_TEST_HOST=127.0.0.1
REDIS_TEST_PORT=6379
REDIS_TEST_USERNAME=
REDIS_TEST_PASSWORD=
REDIS_TEST_DB=14
# Leave the cache host/port blank only for local development on the same Redis
# process. Production must use a physically separate cache Redis endpoint.
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6380
REDIS_CACHE_USERNAME=
REDIS_CACHE_PASSWORD=
# Shared local-development fallback uses DB 1; a dedicated endpoint can use DB 0.
REDIS_CACHE_DB=0
# Local stack uses a physically isolated, disposable cache test process.
REDIS_CACHE_TEST_HOST=127.0.0.1
REDIS_CACHE_TEST_PORT=6381
REDIS_CACHE_TEST_USERNAME=
REDIS_CACHE_TEST_PASSWORD=
REDIS_CACHE_TEST_DB=0
# Development defaults only. Production startup requires TLS plus named,
# non-default ACL users on both Redis data planes.
REDIS_TLS_ENABLED=false
REDIS_CACHE_TLS_ENABLED=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_MAX_RETRIES_PER_REQUEST=2
# Emit the first cache dependency failure immediately, then at most once per
# low-cardinality channel in this interval. Every failure still increments metrics.
CACHE_DEPENDENCY_FAILURE_LOG_INTERVAL_MS=30000
# Examples only: derive thresholds from the real external Redis memory budgets.
REDIS_MAIN_MEMORY_WARN=400mb
REDIS_MAIN_MEMORY_FAIL=460mb
REDIS_CACHE_MEMORY_WARN=200mb
REDIS_CACHE_MEMORY_FAIL=240mb
# Sliding generation-control lifecycle; must stay within 86401..7776000 seconds.
CACHE_GENERATION_CONTROL_TTL_SECONDS=604800
CACHE_ADMIN_API_ENABLED=false
CACHE_ADMIN_BREAK_GLASS_TOKEN=
LIMITER_STORE=redis
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
PG_HOST=
PG_PORT=5432
PG_USER=root
PG_PASSWORD=
PG_DATABASE=suar
PG_TEST_DATABASE=suar_test
# Fail fast against the externally managed PostgreSQL service. Statement/query
# timeouts are server/request safeguards, not transaction retry policies.
PG_CONNECTION_TIMEOUT_MS=5000
PG_POOL_ACQUIRE_TIMEOUT_MS=5000
PG_POOL_CREATE_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=30000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SOCIAL_AUTH_PROVIDER_TIMEOUT_MS=8000
LOCK_STORE=redis
ELASTICSEARCH_ENABLED=
ELASTICSEARCH_NODE=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=
ELASTICSEARCH_REQUEST_TIMEOUT_MS=3000
ELASTICSEARCH_MAX_RETRIES=1
SEARCH_DISCOVERY_CURSOR_SECRET=
SKILL_TAXONOMY_CURSOR_SECRET=
SEARCH_DISCOVERY_CURSOR_TTL_MS=300000
ELASTICSEARCH_ADMIN_ENABLED=false
ELASTICSEARCH_ADMIN_API_KEY=
ELASTICSEARCH_ADMIN_USERNAME=
ELASTICSEARCH_ADMIN_PASSWORD=
SEARCH_INDEX_ADMIN_SERVICE_PRINCIPAL_ID=
ELASTICSEARCH_ADMIN_ALLOW_UNVERIFIED_ROLLBACK=false
# Integration and E2E tests must use the physically separate disposable service
# from laragon-linux (`127.0.0.1:9201`), never the development service on 9200.
ELASTICSEARCH_TEST_ENABLED=true
ELASTICSEARCH_TEST_NODE=http://127.0.0.1:9201
ELASTICSEARCH_TEST_USERNAME=
ELASTICSEARCH_TEST_PASSWORD=
ELASTICSEARCH_TEST_INDEX_PREFIX=suar_test_
# Deterministic local relevance/latency benchmark. Use a dedicated test-owned
# prefix such as `suar_test_benchmark_`; enforcement is opt-in until the
# concurrent test node has a representative resource budget.
SEARCH_BENCHMARK_NOISE_DOCUMENTS=500
SEARCH_BENCHMARK_WARMUP_ITERATIONS=5
SEARCH_BENCHMARK_ITERATIONS=20
SEARCH_BENCHMARK_CONCURRENCY=8
SEARCH_BENCHMARK_RESULT_CUTOFF=5
SEARCH_BENCHMARK_MIN_MRR=0.85
SEARCH_BENCHMARK_MIN_RECALL=0.90
SEARCH_BENCHMARK_MIN_NDCG=0.80
SEARCH_BENCHMARK_MAX_SERIAL_P95_MS=100
SEARCH_BENCHMARK_MAX_CONCURRENT_P95_MS=250
SEARCH_BENCHMARK_ENFORCE=false
# Node HTTP transport limits. REQUEST_TIMEOUT covers receiving the request body;
# application and dependency deadlines remain separately bounded.
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_SOCKET_TIMEOUT_MS=30000
NOTIFICATION_OUTBOX_BATCH_SIZE=100
NOTIFICATION_OUTBOX_CONCURRENCY=8
NOTIFICATION_OUTBOX_LEASE_MS=30000
NOTIFICATION_OUTBOX_HEARTBEAT_MS=10000
NOTIFICATION_OUTBOX_HANDLER_DEADLINE_MS=25000
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=10
NOTIFICATION_OUTBOX_RETRY_BASE_MS=1000
NOTIFICATION_OUTBOX_RETRY_CAP_MS=300000
NOTIFICATION_OUTBOX_POLL_MS=1000
NOTIFICATION_FANOUT_MAX_TARGETS=10000
NOTIFICATION_FANOUT_BATCH_SIZE=100
NOTIFICATION_FANOUT_CONCURRENCY=8
NOTIFICATION_FANOUT_LEASE_MS=30000
NOTIFICATION_FANOUT_MAX_ATTEMPTS=10
NOTIFICATION_FANOUT_RETRY_BASE_MS=1000
NOTIFICATION_FANOUT_RETRY_CAP_MS=300000
NOTIFICATION_FANOUT_POLL_MS=1000
NOTIFICATION_PIPELINE_WARN_AGE_SECONDS=30
NOTIFICATION_PIPELINE_FAIL_AGE_SECONDS=300
NOTIFICATION_PIPELINE_WARN_PENDING=10000
NOTIFICATION_PIPELINE_FAIL_PENDING=100000
NOTIFICATION_RETENTION_BATCH_SIZE=100
# Required by `node ace notification:retention`. Must identify an active service
# principal with `can_manage_notification_operations`; no CLI actor override exists.
NOTIFICATION_RETENTION_SERVICE_PRINCIPAL_ID=
NOTIFICATION_FEED_READ_MODE=postgres
NOTIFICATION_FEED_FALLBACK_ENABLED=true
NOTIFICATION_FEED_FALLBACK_MAX_CONCURRENT=32
NOTIFICATION_FEED_FALLBACK_GLOBAL_MAX_CONCURRENT=64
NOTIFICATION_FEED_FALLBACK_ADMISSION_LEASE_MS=10000
# Optional. Falls back to APP_KEY; use a dedicated >=32-byte secret in production.
# NOTIFICATION_FEED_CURSOR_SECRET=
NOTIFICATION_FEED_CURSOR_KEY_ID=primary
NOTIFICATION_FEED_CURSOR_PREVIOUS_KEYS={}
NOTIFICATION_FEED_CURSOR_TTL_MS=86400000
NOTIFICATION_FEED_CIRCUIT_FAILURE_THRESHOLD=5
NOTIFICATION_FEED_CIRCUIT_OPEN_MS=30000
NOTIFICATION_FEED_SHADOW_LAG_ALLOWANCE_MS=5000
NOTIFICATION_FEED_SHADOW_SAMPLE_RATE=0.1
NOTIFICATION_PROJECTION_ROLLBACK_WINDOW_MS=86400000
NOTIFICATION_UNREAD_CACHE_TTL_SECONDS=300
TRANSMIT_REDIS_ENABLED=true
TRANSMIT_PING_INTERVAL_MS=25000
TRANSMIT_MAX_CONNECTIONS_PER_USER=5
TRANSMIT_MAX_BUFFERED_EVENTS=128
TRANSMIT_MAX_CONNECTION_AGE_MS=900000
CACHE_INVALIDATION_OUTBOX_BATCH_SIZE=25
CACHE_INVALIDATION_OUTBOX_CONCURRENCY=1
CACHE_INVALIDATION_OUTBOX_LEASE_MS=60000
CACHE_INVALIDATION_OUTBOX_HEARTBEAT_MS=15000
CACHE_INVALIDATION_OUTBOX_MAX_ATTEMPTS=10
CACHE_INVALIDATION_OUTBOX_RETRY_BASE_MS=1000
CACHE_INVALIDATION_OUTBOX_RETRY_CAP_MS=300000
CACHE_INVALIDATION_OUTBOX_POLL_MS=1000
CACHE_INVALIDATION_OUTBOX_RETENTION_DAYS=7
CACHE_INVALIDATION_OUTBOX_WARN_AGE_SECONDS=30
CACHE_INVALIDATION_OUTBOX_FAIL_AGE_SECONDS=300
DOMAIN_EVENT_OUTBOX_WARN_DUE_PENDING=1000
DOMAIN_EVENT_OUTBOX_FAIL_DUE_PENDING=10000
DOMAIN_EVENT_OUTBOX_WARN_DUE_AGE_SECONDS=30
DOMAIN_EVENT_OUTBOX_FAIL_DUE_AGE_SECONDS=300
DOMAIN_EVENT_OUTBOX_FAIL_EXPIRED_LEASE_AGE_SECONDS=60
DOMAIN_EVENT_OUTBOX_BATCH_SIZE=50
DOMAIN_EVENT_OUTBOX_CONCURRENCY=4
DOMAIN_EVENT_OUTBOX_LEASE_MS=180000
DOMAIN_EVENT_OUTBOX_HEARTBEAT_MS=10000
DOMAIN_EVENT_OUTBOX_HANDLER_DEADLINE_MS=120000
DOMAIN_EVENT_OUTBOX_MAX_ATTEMPTS=10
DOMAIN_EVENT_OUTBOX_RETRY_BASE_MS=1000
DOMAIN_EVENT_OUTBOX_RETRY_CAP_MS=300000
DOMAIN_EVENT_OUTBOX_POLL_MS=1000
HEALTH_CHECK_API_KEY=
# Dedicated Prometheus collector secret; do not reuse HEALTH_CHECK_API_KEY.
METRICS_API_KEY=
# Dedicated credential for test fixture/auth routes when enabled in development.
TESTING_ROUTES_API_KEY=
# Required only by `node ace domain-events:outbox-dlq`. Must identify an active
# service-principal user with `can_manage_system_settings`; the CLI fails closed
# when absent or unauthorized and never accepts operator identity from a flag.
DOMAIN_EVENT_DLQ_SERVICE_PRINCIPAL_ID=
# Required only by `node ace domain-events:outbox-retention`. Must identify an
# active service principal with `can_manage_system_settings`.
DOMAIN_EVENT_OUTBOX_RETENTION_SERVICE_PRINCIPAL_ID=
DOMAIN_EVENT_OUTBOX_PROCESSED_RETENTION_DAYS=30
DOMAIN_EVENT_OUTBOX_REPLAY_HISTORY_RETENTION_DAYS=365
DOMAIN_EVENT_OUTBOX_RETENTION_BATCH_SIZE=500
# Required by `node ace error-events:retention`. Must identify an active
# service principal with `can_manage_system_settings`; no CLI actor override exists.
ERROR_EVENT_RETENTION_SERVICE_PRINCIPAL_ID=
ERROR_EVENT_RETENTION_DAYS=30
ERROR_EVENT_RETENTION_BATCH_SIZE=100
# Error reporting is best-effort and must never amplify a PostgreSQL outage.
ERROR_EVENT_INSERT_TIMEOUT_MS=1000
ERROR_EVENT_MAX_IN_FLIGHT=4
ERROR_EVENT_CIRCUIT_OPEN_MS=15000
CLAWAGENT_API_URL=http://localhost:18080/api/public/disputes/arbitrate
# End-to-end deadline covers response headers and the bounded response body.
CLAWAGENT_REQUEST_TIMEOUT_MS=10000
# Diagnostics are redacted and truncated before persistence.
CLAWAGENT_MAX_DIAGNOSTIC_BYTES=1024
# Durable trigger reconciliation: exponential backoff with jitter and a hard retry budget.
CLAWAGENT_TRIGGER_MAX_ATTEMPTS=8
CLAWAGENT_TRIGGER_RETRY_BASE_MS=1000
CLAWAGENT_TRIGGER_RETRY_CAP_MS=300000
# Must be comfortably above CLAWAGENT_REQUEST_TIMEOUT_MS.
CLAWAGENT_TRIGGER_STALE_DISPATCH_MS=60000
CLAWAGENT_TRIGGER_BATCH_SIZE=25
CLAWAGENT_TRIGGER_POLL_MS=1000
SUAR_CALLBACK_URL=http://localhost:3333/api/public/ai-disputes/callback
SUAR_DISPUTE_API_KEY=
SUAR_AI_DISPUTE_AUTO_ACTOR_ID=
SUAR_AI_DISPUTE_AUTO_PROVIDER=clawagent
AI_CALLBACK_SECRET=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Code editor for Youch error pages (vscode, sublime, phpstorm, atom, textmate, macvim, emacs)
IDE=vscode
